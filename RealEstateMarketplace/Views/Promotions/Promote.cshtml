@model List<PromotionPlan>
@{
    ViewData["Title"] = "Promote listing";
    var listing = (PropertyListing)ViewBag.Listing;
    bool running = listing.FeaturedUntil != null && listing.FeaturedUntil > DateTime.UtcNow;
}

<div class="container py-4">
    <h2>Promote “@listing.Title”</h2>
    <p class="text-muted mb-1">Featured listings appear first in search results and on the map, with a ★ Featured badge.</p>
    <p class="text-muted small">This payment is for advertising only. It is not a payment for the property.</p>

    @if (running)
    {
        <div class="alert alert-info">
            This listing is already featured until <strong>@listing.FeaturedUntil!.Value.ToLocalTime().ToString("f")</strong>.
            A new plan starts when the current one ends.
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">No promotion plans are available right now.</div>
    }

    <div class="row g-3">
        @foreach (var plan in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm @(plan.Level == PromotionLevel.Premium ? "border-warning" : "")">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-warning text-dark align-self-start mb-2">@plan.Level</span>
                        <h4 class="card-title">@plan.Name</h4>
                        <div class="fs-3 fw-bold mb-1">@plan.Price.ToString("N2") <small class="fs-6">@plan.Currency</small></div>
                        <div class="text-muted mb-3">@plan.DurationDays days</div>
                        <p class="flex-grow-1">@plan.Description</p>
                        <form asp-action="Start" method="post">
                            <input type="hidden" name="listingId" value="@listing.Id" />
                            <input type="hidden" name="planId" value="@plan.Id" />
                            <button class="btn btn-primary w-100">Choose @plan.Name</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <a asp-controller="PropertyListings" asp-action="MyListings" class="btn btn-link mt-3">← Back to my listings</a>
</div>
