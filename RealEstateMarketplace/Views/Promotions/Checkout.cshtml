@model RealEstateMarketplace.Controllers.CheckoutViewModel
@{ ViewData["Title"] = "Checkout"; }

<div class="container py-4" style="max-width:640px">
    <h2>Checkout</h2>

    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between">
            <div>
                <div class="fw-semibold">@Model.PlanName — @Model.DurationDays days</div>
                <div class="text-muted small">@Model.ListingTitle</div>
            </div>
            <div class="fs-4 fw-bold">@Model.Amount.ToString("N2") @Model.Currency</div>
        </div>
    </div>

    <div class="alert alert-secondary small">
        <strong>Test payment gateway.</strong> No real money is charged and card details are not stored.
        Use <code>4242 4242 4242 4242</code> (success), <code>4000 0000 0000 0002</code> (declined)
        or <code>4000 0000 0000 9995</code> (insufficient funds), any future expiry date and any 3-digit CVC.
    </div>

    @if (!string.IsNullOrEmpty(Model.LastError))
    {
        <div class="alert alert-danger">@Model.LastError</div>
    }

    <form asp-action="Checkout" asp-route-id="@Model.PaymentId" method="post" class="card card-body shadow-sm" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="CardholderName" class="form-label"></label>
            <input asp-for="CardholderName" class="form-control" />
            <span asp-validation-for="CardholderName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CardNumber" class="form-label"></label>
            <input asp-for="CardNumber" class="form-control" inputmode="numeric" placeholder="4242 4242 4242 4242" />
            <span asp-validation-for="CardNumber" class="text-danger"></span>
        </div>
        <div class="row g-2 mb-3">
            <div class="col-4">
                <label asp-for="ExpMonth" class="form-label"></label>
                <input asp-for="ExpMonth" class="form-control" type="number" min="1" max="12" />
            </div>
            <div class="col-4">
                <label asp-for="ExpYear" class="form-label"></label>
                <input asp-for="ExpYear" class="form-control" type="number" min="2000" max="2100" />
            </div>
            <div class="col-4">
                <label asp-for="Cvc" class="form-label"></label>
                <input asp-for="Cvc" class="form-control" inputmode="numeric" maxlength="4" />
            </div>
        </div>

        <button class="btn btn-success btn-lg" id="payBtn">Pay @Model.Amount.ToString("N2") @Model.Currency</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Prevent double clicks from sending the form twice
        document.querySelector('form[method=post]').addEventListener('submit', function () {
            const b = document.getElementById('payBtn');
            setTimeout(() => { b.disabled = true; b.textContent = 'Processing…'; }, 0);
        });
    </script>
}
