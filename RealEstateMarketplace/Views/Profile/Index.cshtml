
@model RealEstateMarketplace.Models.ApplicationUser

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-5">

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <strong>Success!</strong>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm">

                <!-- Card Header -->
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">My Profile</h3>
                </div>

                <div class="card-body p-4">

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }

                    <!-- Profile picture (optional) -->
                    <div class="d-flex align-items-center gap-3 mb-4">
                        @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                        {
                            <img src="@Model.ProfilePicturePath" alt="Profile picture"
                                 class="rounded-circle border" style="width:96px;height:96px;object-fit:cover" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center fs-2 fw-bold text-secondary"
                                 style="width:96px;height:96px">
                                @(Model.FirstName.Length > 0 ? Model.FirstName[..1].ToUpper() : "?")
                            </div>
                        }
                        <div>
                            <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="d-flex gap-2">
                                <input type="file" name="picture" accept=".jpg,.jpeg,.png,.webp" class="form-control form-control-sm" required />
                                <button class="btn btn-sm btn-primary text-nowrap">Upload picture</button>
                            </form>
                            <div class="form-text">Optional. JPG, PNG or WebP, up to 5 MB.</div>
                            @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                            {
                                <form asp-action="RemovePicture" method="post" class="mt-1">
                                    <button class="btn btn-sm btn-link text-danger p-0">Remove picture</button>
                                </form>
                            }
                        </div>
                    </div>

                    <!-- Personal Information -->
                    <h5 class="mb-4">Personal Information</h5>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            First Name
                        </label>

                        <input class="form-control"
                               value="@Model.FirstName"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Last Name
                        </label>

                        <input class="form-control"
                               value="@Model.LastName"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Email Address
                        </label>

                        <input class="form-control"
                               value="@Model.Email"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Phone Number
                        </label>

                        <input class="form-control"
                               value="@(Model.PhoneNumber ?? "Not provided")"
                               readonly />
                    </div>

                    <!-- Profile Actions -->
                    <hr class="my-4" />

                    <h5 class="mb-3">Manage My Account</h5>

                    <div class="d-flex flex-wrap gap-2">

                        <!-- Edit Profile -->
                        <a asp-controller="Profile"
                           asp-action="Edit"
                           class="btn btn-primary">
                            Edit Profile
                        </a>

                        <!-- My Listings -->
                        <a asp-controller="PropertyListings"
                           asp-action="MyListings"
                           class="btn btn-outline-primary">
                            My Listings
                        </a>

                        <!-- My Favorites -->
                        <a asp-controller="Favorites"
                           asp-action="Index"
                           class="btn btn-outline-danger">
                            <i class="bi bi-heart-fill me-1"></i>
                            My Favorites
                        </a>

                        <!-- My Requests -->
                        <a asp-controller="PropertyInquiries"
                           asp-action="MyRequests"
                           class="btn btn-outline-success">
                            My Requests
                        </a>

                        <!-- Promotion payments -->
                        <a asp-controller="Promotions"
                           asp-action="MyPayments"
                           class="btn btn-outline-warning">
                            My Payments
                        </a>

                        <!-- Transactions & reviews -->
                        <a asp-controller="Transactions"
                           asp-action="MyTransactions"
                           class="btn btn-outline-dark">
                            Transactions &amp; Reviews
                        </a>

                        <!-- Change Password -->
                        <a asp-area="Identity"
                           asp-page="/Account/Manage/ChangePassword"
                           class="btn btn-outline-secondary">
                            Change Password
                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>
