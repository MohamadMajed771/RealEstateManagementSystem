
@model IEnumerable<RealEstateMarketplace.Models.Conversation>

@{
    ViewData["Title"] = "My Conversations";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Conversations</h2>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <h5>No conversations yet.</h5>

            <p class="mb-0">
                Visit a property listing and click
                "Chat with Landlord" to start a conversation.
            </p>
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var conversation in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="card-title">
                                @conversation.PropertyListing.Title
                            </h5>

                            <p class="text-muted">
                                Conversation #@conversation.Id
                            </p>

                            <p>
                                <strong>Status:</strong>

                                @if (conversation.IsClosed)
                                {
                                    <span class="badge bg-secondary">
                                        Closed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                            </p>

                            <p class="small text-muted">
                                Last activity:
                                @(conversation.LastMessageAt
                                    ?? conversation.CreatedAt)
                                    .ToLocalTime()
                                    .ToString("g")
                            </p>

                            <a asp-controller="Chat"
                               asp-action="Details"
                               asp-route-id="@conversation.Id"
                               class="btn btn-primary w-100">

                                Open Chat

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    <a asp-controller="Properties"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">

        Back to Properties

    </a>

</div>
