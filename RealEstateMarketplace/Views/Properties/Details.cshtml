
@using System.Security.Claims
@using System.Globalization
@using RealEstateMarketplace.Models

@model RealEstateMarketplace.ViewModels.PublicPropertyDetailsViewModel

@{
    ViewData["Title"] = Model.Title;

    var isSale = Model.ListingType == ListingType.Sale;

    var actionText = isSale
        ? "Buy This Property"
        : "Rent This Property";

    var requestText = isSale
        ? "Request to Buy"
        : "Request to Rent";

    var currentUserId =
        User.FindFirstValue(ClaimTypes.NameIdentifier);

    var isAuthenticated =
        User.Identity?.IsAuthenticated == true;

    var isOwner =
        isAuthenticated &&
        currentUserId == Model.SellerId;
}

<div class="container py-4">

    <!-- Smart Back Button -->
    @{
        var from = Context.Request.Query["from"].ToString();

        var returnUrl = Context.Request.Query["returnUrl"].ToString();

        var validReturnUrl =
            !string.IsNullOrWhiteSpace(returnUrl) &&
            Url.IsLocalUrl(returnUrl);

        var backUrl = validReturnUrl
            ? returnUrl
            : from == "incoming" && isOwner
                ? Url.Action("Incoming", "PropertyInquiries")
                : Url.Action("Index", "Properties");

        var backText = validReturnUrl
            ? "Back to My Transactions"
            : from == "incoming" && isOwner
                ? "Back to Incoming Requests"
                : "Back to Properties";
    }

    <a href="@backUrl" class="btn btn-outline-secondary mb-4">
        &larr; @backText
    </a>

    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Property Header -->
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

        <div>
            <h1 class="fw-bold">@Model.Title</h1>

            <p class="text-muted mb-0">
                📍 @Model.Area, @Model.City, @Model.Country
            </p>
        </div>

        <div class="text-md-end">

            <span class="badge bg-primary mb-2">
                @Model.ListingType
            </span>

            <h2 class="text-primary fw-bold">
                @Model.Price.ToString("N0") @Model.Currency
            </h2>

            @if (!isSale)
            {
                <small class="text-muted">
                    Rental price
                </small>
            }

        </div>
    </div>

    <!-- Photo Gallery -->
    @if (Model.Photos.Any())
    {
        <div id="propertyGallery"
             class="carousel slide mb-4"
             data-bs-ride="false">

            <div class="carousel-inner rounded overflow-hidden">

                @for (int i = 0; i < Model.Photos.Count; i++)
                {
                    var photo = Model.Photos[i];

                    <div class="carousel-item @(i == 0 ? "active" : "")">

                        <img src="@Url.Content(photo.ImagePath)"
                             class="d-block w-100"
                             style="height:450px;object-fit:cover;"
                             alt="@(photo.Caption ?? Model.Title)" />

                    </div>
                }

            </div>

            @if (Model.Photos.Count > 1)
            {
                <button class="carousel-control-prev"
                        type="button"
                        data-bs-target="#propertyGallery"
                        data-bs-slide="prev">

                    <span class="carousel-control-prev-icon"></span>
                    <span class="visually-hidden">Previous</span>
                </button>

                <button class="carousel-control-next"
                        type="button"
                        data-bs-target="#propertyGallery"
                        data-bs-slide="next">

                    <span class="carousel-control-next-icon"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            }

        </div>
    }
    else
    {
        <div class="bg-light text-center p-5 rounded mb-4">
            <p class="text-muted mb-0">
                No photos available.
            </p>
        </div>
    }

    <div class="row g-4">

        <!-- Main Content -->
        <div class="col-lg-8">

            <!-- Property Overview -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Property Overview
                    </h4>

                    <div class="row g-3">

                        <div class="col-sm-6">
                            <strong>Property Type:</strong>
                            @Model.PropertyType
                        </div>

                        <div class="col-sm-6">
                            <strong>Listing Type:</strong>
                            @Model.ListingType
                        </div>

                        <div class="col-sm-6">
                            <strong>Size:</strong>
                            @Model.SizeSquareMeters.ToString("N2") m²
                        </div>

                        @if (Model.Bedrooms.HasValue)
                        {
                            <div class="col-sm-6">
                                <strong>Bedrooms:</strong>
                                @Model.Bedrooms
                            </div>
                        }

                        @if (Model.Bathrooms.HasValue)
                        {
                            <div class="col-sm-6">
                                <strong>Bathrooms:</strong>
                                @Model.Bathrooms
                            </div>
                        }

                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Description
                    </h4>

                    <p style="white-space:pre-line;">
                        @Model.Description
                    </p>

                </div>
            </div>

            <!-- Location -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Location
                    </h4>

                    <p>
                        @Model.Area, @Model.City, @Model.Country
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.StreetAddress))
                    {
                        <p class="text-muted">
                            @Model.StreetAddress
                        </p>
                    }

                    @if (Model.Latitude.HasValue &&
                         Model.Longitude.HasValue)
                    {
                        <div id="propertyMap"
                             style="height:350px;width:100%;"
                             class="rounded border">
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">
                            Exact map location is unavailable.
                        </p>
                    }

                </div>
            </div>

        </div>

        <!-- Seller / Action Sidebar -->
        <div class="col-lg-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Seller Information
                    </h4>

                    <p>
                        <strong>Seller:</strong>
                        @Model.SellerName
                    </p>

                    <hr />

                    <h5 class="text-primary fw-bold">
                        @Model.Price.ToString("N0") @Model.Currency
                    </h5>

                    @* OWNER *@
                    @if (isOwner)
                    {
                        <a asp-controller="PropertyListings"
                           asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary w-100 mt-3">
                            Edit My Listing
                        </a>

                        <p class="small text-muted mt-2 mb-0">
                            You are the owner of this property.
                        </p>

                        <!-- Owner can access received chats -->
                        <a asp-controller="Chat"
                           asp-action="Index"
                           class="btn btn-outline-primary w-100 mt-3">
                            My Messages
                        </a>
                    }
                    else if (isAuthenticated)
                    {
                        @* AUTHENTICATED NON-OWNER *@

                        <!-- Request to Buy or Rent -->
                        <form asp-controller="PropertyInquiries"
                              asp-action="Create"
                              method="post"
                              class="mt-3">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="propertyListingId"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-success w-100"
                                    onclick="return confirm('Are you sure you want to submit this request?');">
                                @requestText
                            </button>

                        </form>

                        <p class="small text-muted mt-2 mb-0">
                            @(isSale
                                ? "Submit a purchase request to the property owner."
                                : "Submit a rental request to the property owner.")
                        </p>

                        <!-- NEW: CHAT WITH LANDLORD -->
                        <form asp-controller="Chat"
                              asp-action="Start"
                              method="post"
                              class="mt-3">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="propertyListingId"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-outline-primary w-100">
                                <i class="bi bi-chat-dots me-1"></i>
                                @(isSale
                                    ? "Chat with Seller"
                                    : "Chat with Landlord")
                            </button>

                        </form>

                        <p class="small text-muted mt-2 mb-0">
                            Contact the property owner directly to ask
                            questions or negotiate the price.
                        </p>
                    }
                    else
                    {
                        @* GUEST *@

                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           asp-route-returnUrl="@Url.Action("Details", "Properties", new { id = Model.Id })"
                           class="btn btn-success w-100 mt-3">
                            @actionText
                        </a>

                        <p class="small text-muted mt-2 mb-0">
                            Please log in or register to continue.
                        </p>

                        <a asp-area="Identity"
                           asp-page="/Account/Register"
                           asp-route-returnUrl="@Url.Action("Details", "Properties", new { id = Model.Id })"
                           class="btn btn-outline-primary w-100 mt-2">
                            Create an Account
                        </a>

                        <!-- Guest chat login -->
                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           asp-route-returnUrl="@Url.Action("Details", "Properties", new { id = Model.Id })"
                           class="btn btn-outline-secondary w-100 mt-3">
                            Log In to Chat with Owner
                        </a>
                    }

                </div>
            </div>

        </div>

    </div>
</div>

<!-- Leaflet / OpenStreetMap -->
@if (Model.Latitude.HasValue && Model.Longitude.HasValue)
{
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const lat = @Model.Latitude.Value.ToString(
                CultureInfo.InvariantCulture);

            const lng = @Model.Longitude.Value.ToString(
                CultureInfo.InvariantCulture);

            const map = L.map("propertyMap")
                .setView([lat, lng], 15);

            L.tileLayer(
                "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap contributors'
                }
            ).addTo(map);

            L.marker([lat, lng])
                .addTo(map)
                .bindPopup("Property Location")
                .openPopup();

        });
    </script>
}
