
@using System.Security.Claims
@using System.Globalization
@using RealEstateMarketplace.Models

@model RealEstateMarketplace.ViewModels.PublicPropertyDetailsViewModel

@{
    ViewData["Title"] = Model.Title;

    var isSale = Model.ListingType == ListingType.Sale;

    var actionText = isSale
        ? "Buy This Property"
        : "Rent This Property";

    var requestText = isSale
        ? "Request to Buy"
        : "Request to Rent";

    var currentUserId =
        User.FindFirstValue(ClaimTypes.NameIdentifier);

    var isAuthenticated =
        User.Identity?.IsAuthenticated == true;

    var isOwner =
        isAuthenticated &&
        currentUserId == Model.SellerId;

    var isFavorite = ViewBag.IsFavorite == true;

    var isClosed = Model.Status != ListingStatus.Approved;
}

<div class="container py-4">

    <!-- Smart Back Button -->
    @{
        var from = Context.Request.Query["from"].ToString();

        var returnUrl = Context.Request.Query["returnUrl"].ToString();

        var validReturnUrl =
            !string.IsNullOrWhiteSpace(returnUrl) &&
            Url.IsLocalUrl(returnUrl);

        var backUrl = validReturnUrl
            ? returnUrl
            : from == "incoming" && isOwner
                ? Url.Action("Incoming", "PropertyInquiries")
                : Url.Action("Index", "Properties");

        var backText = validReturnUrl
            ? "Back to My Transactions"
            : from == "incoming" && isOwner
                ? "Back to Incoming Requests"
                : "Back to Properties";
    }

    <a href="@backUrl"
       class="btn btn-outline-secondary mb-4">
        &larr; @backText
    </a>

    @if (isClosed)
    {
        <div class="alert alert-secondary">
            This property has been @(Model.Status == ListingStatus.Rented ? "rented" : "sold")
            and is no longer available. The page stays visible for its verified reviews.
        </div>
    }

    <!-- Success Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Property Header -->
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

        <div>
            <h1 class="fw-bold">@Model.Title</h1>

            <p class="text-muted mb-0">
                📍 @Model.Area, @Model.City, @Model.Country
            </p>
        </div>

        <div class="text-md-end">

            <span class="badge bg-primary mb-2">
                @Model.ListingType
            </span>

            <h2 class="text-primary fw-bold">
                @Model.Price.ToString("N0") @Model.Currency
            </h2>

            @if (!isSale)
            {
                <small class="text-muted">
                    Rental price
                </small>
            }

        </div>
    </div>

    <!-- Photo Gallery -->
    @if (Model.Photos.Any())
    {
        <div id="propertyGallery"
             class="carousel slide mb-4"
             data-bs-ride="false">

            <div class="carousel-inner rounded overflow-hidden">

                @for (int i = 0; i < Model.Photos.Count; i++)
                {
                    var photo = Model.Photos[i];

                    <div class="carousel-item @(i == 0 ? "active" : "")">

                        <img src="@Url.Content(photo.ImagePath)"
                             class="d-block w-100"
                             style="height:450px;object-fit:cover;"
                             alt="@(photo.Caption ?? Model.Title)" />

                    </div>
                }

            </div>

            @if (Model.Photos.Count > 1)
            {
                <button class="carousel-control-prev"
                        type="button"
                        data-bs-target="#propertyGallery"
                        data-bs-slide="prev">

                    <span class="carousel-control-prev-icon"></span>
                    <span class="visually-hidden">Previous</span>
                </button>

                <button class="carousel-control-next"
                        type="button"
                        data-bs-target="#propertyGallery"
                        data-bs-slide="next">

                    <span class="carousel-control-next-icon"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            }

        </div>
    }
    else
    {
        <div class="bg-light text-center p-5 rounded mb-4">
            <p class="text-muted mb-0">
                No photos available.
            </p>
        </div>
    }

    <div class="row g-4">

        <!-- Main Content -->
        <div class="col-lg-8">

            <!-- Property Overview -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Property Overview
                    </h4>

                    <div class="row g-3">

                        <div class="col-sm-6">
                            <strong>Property Type:</strong>
                            @Model.PropertyType
                        </div>

                        <div class="col-sm-6">
                            <strong>Listing Type:</strong>
                            @Model.ListingType
                        </div>

                        <div class="col-sm-6">
                            <strong>Size:</strong>
                            @Model.SizeSquareMeters.ToString("N2") m²
                        </div>

                        @if (Model.Bedrooms.HasValue)
                        {
                            <div class="col-sm-6">
                                <strong>Bedrooms:</strong>
                                @Model.Bedrooms
                            </div>
                        }

                        @if (Model.Bathrooms.HasValue)
                        {
                            <div class="col-sm-6">
                                <strong>Bathrooms:</strong>
                                @Model.Bathrooms
                            </div>
                        }

                        <div class="col-sm-6">
                            <strong>Parking:</strong>
                            @(Model.ParkingSpaces > 0 ? $"{Model.ParkingSpaces} space(s)" : "None")
                        </div>

                        <div class="col-sm-6">
                            <strong>Furnished:</strong>
                            @(Model.IsFurnished ? "Yes" : "No")
                        </div>

                        @{
                            var facilities = new List<string>();
                            if (Model.HasBalcony) facilities.Add("Balcony");
                            if (Model.HasGarden) facilities.Add("Garden");
                            if (Model.HasTerrace) facilities.Add("Terrace");
                            if (!string.IsNullOrWhiteSpace(Model.OtherFacilities)) facilities.Add(Model.OtherFacilities);
                        }
                        @if (facilities.Count > 0)
                        {
                            <div class="col-12">
                                <strong>Facilities:</strong>
                                @string.Join(", ", facilities)
                            </div>
                        }

                        @if (!isSale)
                        {
                            <div class="col-sm-6">
                                <strong>Rental period:</strong>
                                @(Model.RentalPeriodMonths.HasValue ? $"{Model.RentalPeriodMonths} months" : "Flexible")
                            </div>
                        }
                        else if (Model.InstallmentsAccepted)
                        {
                            <div class="col-12">
                                <strong>Installments:</strong>
                                Accepted@(Model.InstallmentMonths.HasValue ? $" over {Model.InstallmentMonths} months" : "")
                                <span class="text-muted small">(agreed with the owner; the marketplace does not provide financing)</span>
                            </div>
                        }

                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Description
                    </h4>

                    <p style="white-space:pre-line;">
                        @Model.Description
                    </p>

                </div>
            </div>

            <!-- Reviews -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">
                        Reviews
                        @if (Model.AverageRating.HasValue)
                        {
                            <span class="fs-6 text-warning ms-2">★ @Model.AverageRating.Value.ToString("F1")</span>
                            <span class="fs-6 text-muted">(@Model.Reviews.Count)</span>
                        }
                    </h4>

                    @if (Model.Reviews.Count == 0)
                    {
                        <p class="text-muted mb-0">
                            No reviews yet. Only people who completed a sale or rental of this
                            property through the marketplace can review it.
                        </p>
                    }
                    else
                    {
                        @foreach (var review in Model.Reviews)
                        {
                            <div class="border-bottom pb-2 mb-2">
                                <div class="d-flex justify-content-between">
                                    <strong>@review.ReviewerName
                                        <span class="badge bg-light text-muted border fw-normal ms-1">
                                            Verified @(review.IsRental ? "tenant" : "buyer")
                                        </span>
                                    </strong>
                                    <span class="text-warning">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</span>
                                </div>
                                <div class="small text-muted">
                                    @if (review.AccuracyRating.HasValue) { <span class="me-3">Accuracy @review.AccuracyRating/5</span> }
                                    @if (review.ConditionRating.HasValue) { <span class="me-3">Condition @review.ConditionRating/5</span> }
                                    @if (review.CommunicationRating.HasValue) { <span>Communication @review.CommunicationRating/5</span> }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(review.Comment))
                                {
                                    <div style="white-space:pre-line">@review.Comment</div>
                                }
                                <div class="small text-muted">@review.CreatedAt.ToLocalTime().ToString("d")</div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Location -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Location
                    </h4>

                    <p>
                        @Model.Area, @Model.City, @Model.Country
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.StreetAddress))
                    {
                        <p class="text-muted">
                            @Model.StreetAddress
                        </p>
                    }

                    @if (Model.Latitude.HasValue &&
                         Model.Longitude.HasValue)
                    {
                        <div id="propertyMap"
                             style="height:350px;width:100%;"
                             class="rounded border">
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">
                            Exact map location is unavailable.
                        </p>
                    }

                </div>
            </div>

        </div>

        <!-- Seller / Action Sidebar -->
        <div class="col-lg-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Seller Information
                    </h4>

                    <p class="mb-1">
                        <strong>Owner:</strong>
                        @Model.SellerName
                    </p>
                    <p class="small text-muted mb-1">
                        Member since @Model.SellerMemberSince.ToLocalTime().ToString("MMMM yyyy")
                        · @Model.SellerPublishedListings published listing(s)
                    </p>
                    <p class="small text-muted">
                        @Model.ViewCount view(s)
                        @if (Model.IsFeatured) { <span class="badge bg-warning text-dark ms-1">★ Featured</span> }
                    </p>

                    <hr />

                    <h5 class="text-primary fw-bold">
                        @Model.Price.ToString("N0") @Model.Currency
                    </h5>

                    <!-- FAVORITES -->
                    @if (isAuthenticated)
                    {
                        <form asp-controller="Favorites"
                              asp-action="@(isFavorite ? "Remove" : "Add")"
                              method="post"
                              class="mt-3">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="propertyListingId"
                                   value="@Model.Id" />

                            <input type="hidden"
                                   name="returnUrl"
                                   value="@(Context.Request.Path + Context.Request.QueryString)" />

                            <button type="submit"
                                    class="btn @(isFavorite ? "btn-danger" : "btn-outline-danger") w-100">

                                <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart") me-1"></i>

                                @(isFavorite
                                    ? "Remove from Favorites"
                                    : "Add to Favorites")
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           asp-route-returnUrl="@Url.Action("Details", "Properties", new { id = Model.Id })"
                           class="btn btn-outline-danger w-100 mt-3">

                            <i class="bi bi-heart me-1"></i>
                            Log In to Save Property
                        </a>
                    }

                    <!-- OWNER ACTIONS -->
                    @if (isClosed)
                    {
                        <p class="text-muted mt-3 mb-0">
                            @(Model.Status == ListingStatus.Rented ? "Rented" : "Sold") through RealEstateMarketplace.
                        </p>
                    }
                    else if (isOwner)
                    {
                        <a asp-controller="PropertyListings"
                           asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary w-100 mt-3">
                            Edit My Listing
                        </a>

                        <p class="small text-muted mt-2 mb-0">
                            You are the owner of this property.
                        </p>

                        <a asp-controller="Chat"
                           asp-action="Index"
                           class="btn btn-outline-primary w-100 mt-3">
                            My Messages
                        </a>
                    }
                    else if (isAuthenticated)
                    {
                        <!-- Request to Buy or Rent -->
                        <form asp-controller="PropertyInquiries"
                              asp-action="Create"
                              method="post"
                              class="mt-3">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="propertyListingId"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-success w-100"
                                    onclick="return confirm('Are you sure you want to submit this request?');">
                                @requestText
                            </button>
                        </form>

                        <p class="small text-muted mt-2 mb-0">
                            @(isSale
                                ? "Submit a purchase request to the property owner."
                                : "Submit a rental request to the property owner.")
                        </p>

                        <!-- CHAT WITH SELLER / LANDLORD -->
                        <form asp-controller="Chat"
                              asp-action="Start"
                              method="post"
                              class="mt-3">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="propertyListingId"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-outline-primary w-100">

                                <i class="bi bi-chat-dots me-1"></i>

                                @(isSale
                                    ? "Chat with Seller"
                                    : "Chat with Landlord")
                            </button>
                        </form>

                        <p class="small text-muted mt-2 mb-0">
                            Contact the property owner directly to ask
                            questions or negotiate the price.
                        </p>

                        <!-- REPORT PROPERTY -->
                        <button type="button"
                                class="btn btn-link text-danger w-100 mt-3"
                                data-bs-toggle="modal"
                                data-bs-target="#reportModal">
                            Report this property
                        </button>
                    }
                    else
                    {
                        <!-- GUEST ACTIONS -->
                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           asp-route-returnUrl="@Url.Action("Details", "Properties", new { id = Model.Id })"
                           class="btn btn-success w-100 mt-3">
                            @actionText
                        </a>

                        <p class="small text-muted mt-2 mb-0">
                            Please log in or register to continue.
                        </p>

                        <a asp-area="Identity"
                           asp-page="/Account/Register"
                           asp-route-returnUrl="@Url.Action("Details", "Properties", new { id = Model.Id })"
                           class="btn btn-outline-primary w-100 mt-2">
                            Create an Account
                        </a>

                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           asp-route-returnUrl="@Url.Action("Details", "Properties", new { id = Model.Id })"
                           class="btn btn-outline-secondary w-100 mt-3">
                            Log In to Chat with Owner
                        </a>
                    }

                </div>
            </div>

        </div>

    </div>
</div>

@if (isAuthenticated && !isOwner)
{
    <div class="modal fade" id="reportModal" tabindex="-1" aria-labelledby="reportModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" asp-controller="PropertyReports" asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="reportModalLabel">Report this property</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="propertyListingId" value="@Model.Id" />
                    <label class="form-label">Reason</label>
                    <select name="reason" class="form-select mb-3" required>
                        <option value="@PropertyReportReason.IncorrectInformation">Incorrect information</option>
                        <option value="@PropertyReportReason.FakePhotos">Misleading photos</option>
                        <option value="@PropertyReportReason.FraudOrScam">Suspicious listing / scam</option>
                        <option value="@PropertyReportReason.DuplicateListing">Duplicate listing</option>
                        <option value="@PropertyReportReason.InappropriateContent">Inappropriate content</option>
                        <option value="@PropertyReportReason.SuspiciousSeller">Suspicious owner</option>
                        <option value="@PropertyReportReason.Other">Other</option>
                    </select>
                    <label class="form-label">Explanation</label>
                    <textarea name="description" class="form-control" rows="4" minlength="10" maxlength="2000" required
                              placeholder="What does not match the listing?"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Send report</button>
                </div>
            </form>
        </div>
    </div>
}

<!-- Leaflet / OpenStreetMap -->
@if (Model.Latitude.HasValue && Model.Longitude.HasValue)
{
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const lat = @Model.Latitude.Value.ToString(
                CultureInfo.InvariantCulture);

            const lng = @Model.Longitude.Value.ToString(
                CultureInfo.InvariantCulture);

            const map = L.map("propertyMap")
                .setView([lat, lng], 15);

            L.tileLayer(
                "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap contributors'
                }
            ).addTo(map);

            L.marker([lat, lng])
                .addTo(map)
                .bindPopup("Property Location")
                .openPopup();

        });
    </script>
}
