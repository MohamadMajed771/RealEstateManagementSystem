
@using System.Security.Claims
@using RealEstateMarketplace.Models

@model IEnumerable<RealEstateMarketplace.ViewModels.PublicPropertyCardViewModel>

@{
    ViewData["Title"] = "Browse Properties";

    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var selectedListingType = ViewBag.ListingType?.ToString();
    var selectedPropertyType = ViewBag.PropertyType?.ToString();
    var selectedCity = ViewBag.City?.ToString();

    var selectedMinPrice = ViewBag.MinPrice?.ToString();
    var selectedMaxPrice = ViewBag.MaxPrice?.ToString();
    var selectedMinBedrooms = ViewBag.MinBedrooms?.ToString();
    var selectedMinBathrooms = ViewBag.MinBathrooms?.ToString();
    var selectedMinSize = ViewBag.MinSize?.ToString();

    var currentUrl = Context.Request.Path + Context.Request.QueryString;

    var criteria = ViewBag.Criteria as RealEstateMarketplace.Services.PropertySearchCriteria
        ?? new RealEstateMarketplace.Services.PropertySearchCriteria();

    var inv = System.Globalization.CultureInfo.InvariantCulture;

    // Marker data for the map (only listings with coordinates)
    var mapItems = Model
        .Where(p => p.Latitude.HasValue && p.Longitude.HasValue)
        .Select(p => new
        {
            id = p.Id,
            lat = p.Latitude,
            lng = p.Longitude,
            title = p.Title,
            type = p.PropertyType.ToString(),
            listing = p.ListingType.ToString(),
            price = p.Price.ToString("N0") + " " + p.Currency + (p.ListingType == ListingType.Rent ? " / month" : ""),
            place = p.Area + ", " + p.City,
            photo = string.IsNullOrEmpty(p.CoverPhotoPath) ? null : Url.Content(p.CoverPhotoPath),
            featured = p.IsFeatured,
            url = Url.Action("Details", "Properties", new { id = p.Id })
        });
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container py-5">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="fw-bold">Explore Properties</h1>
            <p class="text-muted">
                Find your next home, office, or investment.
            </p>
        </div>

        <span class="badge bg-primary fs-6">
            @Model.Count() Properties
        </span>
    </div>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- ERROR MESSAGE -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- ADVANCED FILTERS -->
    <div class="card shadow-sm border-0 mb-5">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-funnel me-2"></i>
                Advanced Property Search
            </h5>
        </div>

        <div class="card-body p-4">

            <!-- SEARCH FORM -->
            <form id="propertySearchForm"
                  asp-controller="Properties"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <!-- LISTING TYPE -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Listing Type
                        </label>

                        <select name="listingType"
                                class="form-select">

                            <option value="">All Listings</option>

                            @foreach (var type in Enum.GetValues<ListingType>())
                            {
                                if (selectedListingType == type.ToString())
                                {
                                    <option value="@type" selected>
                                        @type
                                    </option>
                                }
                                else
                                {
                                    <option value="@type">
                                        @type
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- PROPERTY TYPE -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Property Type
                        </label>

                        <select name="propertyType"
                                class="form-select">

                            <option value="">All Property Types</option>

                            @foreach (var type in Enum.GetValues<PropertyType>())
                            {
                                if (selectedPropertyType == type.ToString())
                                {
                                    <option value="@type" selected>
                                        @type
                                    </option>
                                }
                                else
                                {
                                    <option value="@type">
                                        @type
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- CITY -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            City
                        </label>

                        <input type="text"
                               name="city"
                               value="@selectedCity"
                               class="form-control"
                               placeholder="e.g. Beirut, Jounieh, Baabda" />
                    </div>

                    <!-- MINIMUM PRICE -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Minimum Price (USD)
                        </label>

                        <input type="number"
                               name="minPrice"
                               value="@selectedMinPrice"
                               class="form-control"
                               min="0"
                               step="0.01"
                               placeholder="Minimum price" />
                    </div>

                    <!-- MAXIMUM PRICE -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Maximum Price (USD)
                        </label>

                        <input type="number"
                               name="maxPrice"
                               value="@selectedMaxPrice"
                               class="form-control"
                               min="0"
                               step="0.01"
                               placeholder="Maximum price" />
                    </div>

                    <!-- MINIMUM BEDROOMS -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Minimum Bedrooms
                        </label>

                        <input type="number"
                               name="minBedrooms"
                               value="@selectedMinBedrooms"
                               class="form-control"
                               min="0"
                               placeholder="e.g. 2" />
                    </div>

                    <!-- MINIMUM BATHROOMS -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Minimum Bathrooms
                        </label>

                        <input type="number"
                               name="minBathrooms"
                               value="@selectedMinBathrooms"
                               class="form-control"
                               min="0"
                               placeholder="e.g. 1" />
                    </div>

                    <!-- MINIMUM SIZE -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Minimum Surface Area (m²)
                        </label>

                        <input type="number"
                               name="minSize"
                               value="@selectedMinSize"
                               class="form-control"
                               min="0"
                               step="0.01"
                               placeholder="e.g. 100" />
                    </div>

                    <!-- MAX SIZE -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Maximum Surface Area (m²)</label>
                        <input type="number" name="maxSize" value="@criteria.MaxSize" class="form-control"
                               min="0" step="0.01" placeholder="e.g. 250" />
                    </div>

                    <!-- FURNISHED -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Furnished</label>
                        <select name="furnished" class="form-select">
                            <option value="">Any</option>
                            <option value="true" selected="@(criteria.Furnished == true)">Furnished</option>
                            <option value="false" selected="@(criteria.Furnished == false)">Unfurnished</option>
                        </select>
                    </div>

                    <!-- PARKING -->
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="hasParking" value="true"
                                   id="hasParking" checked="@(criteria.HasParking == true)" />
                            <label class="form-check-label fw-semibold" for="hasParking">Parking available</label>
                        </div>
                    </div>

                    <!-- DISTANCE -->
                    <div class="col-md-8">
                        <label class="form-label fw-semibold">Distance from a point</label>
                        <div class="input-group">
                            <select name="radiusKm" id="radiusKm" class="form-select" style="max-width:160px">
                                <option value="">Any distance</option>
                                @foreach (var km in new[] { 1, 2, 5, 10, 20, 50 })
                                {
                                    <option value="@km" selected="@(criteria.RadiusKm == km)">Within @km km</option>
                                }
                            </select>
                            <input type="hidden" name="lat" id="centerLat" value="@criteria.Lat?.ToString(inv)" />
                            <input type="hidden" name="lng" id="centerLng" value="@criteria.Lng?.ToString(inv)" />
                            <span class="input-group-text small" id="centerLabel">
                                @(criteria.Lat.HasValue ? $"Point: {criteria.Lat:F4}, {criteria.Lng:F4}" : "Click the map to choose a point")
                            </span>
                            <button type="button" class="btn btn-outline-secondary" id="useMyLocation">
                                My location
                            </button>
                        </div>
                    </div>

                </div>

                <!-- FILTER ACTIONS -->
                <div class="d-flex flex-wrap gap-2 mt-4">

                    <!-- SEARCH -->
                    <button type="submit"
                            class="btn btn-primary px-4">
                        <i class="bi bi-search me-1"></i>
                        Search Properties
                    </button>

                    <!-- CLEAR -->
                    <a asp-controller="Properties"
                       asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Clear Filters
                    </a>

                    <!-- SAVE SEARCH -->
                    @if (isAuthenticated)
                    {
                        <button type="button"
                                class="btn btn-outline-success px-4"
                                data-bs-toggle="modal"
                                data-bs-target="#saveSearchModal">
                            <i class="bi bi-bookmark-plus me-1"></i>
                            Save This Search
                        </button>
                    }
                    else
                    {
                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           asp-route-returnUrl="@currentUrl"
                           class="btn btn-outline-success px-4">
                            <i class="bi bi-bookmark-plus me-1"></i>
                            Log In to Save Search
                        </a>
                    }

                    <!-- MY SAVED SEARCHES -->
                    @if (isAuthenticated)
                    {
                        <a asp-controller="SavedSearches"
                           asp-action="Index"
                           class="btn btn-outline-primary px-4">
                            <i class="bi bi-bookmarks me-1"></i>
                            My Saved Searches
                        </a>
                    }

                </div>

            </form>
        </div>
    </div>

    <!-- INTERACTIVE MAP -->
    <div class="card shadow-sm border-0 mb-5">
        <div class="card-body p-0">
            <div id="searchMap" style="height:480px;border-radius:.375rem;"></div>
        </div>
        <div class="card-footer bg-white small text-muted">
            Click a marker to preview a property. Click anywhere on the map to search around that point.
            @(Model.Count() - mapItems.Count() > 0 ? $"{Model.Count() - mapItems.Count()} result(s) have no map location." : "")
        </div>
    </div>

    <!-- PROPERTY RESULTS -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h4 class="fw-bold mb-0">
            Available Properties
        </h4>

        <span class="text-muted">
            @Model.Count() results found
        </span>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">

            <h4>No matching properties found</h4>

            <p class="mb-0">
                Try changing your filters or clearing them
                to see more properties.
            </p>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var property in Model)
            {
                var isSale = property.ListingType == ListingType.Sale;

                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0">

                        <!-- PROPERTY PHOTO -->
                        @if (!string.IsNullOrEmpty(property.CoverPhotoPath))
                        {
                            <img src="@Url.Content(property.CoverPhotoPath)"
                                 class="card-img-top"
                                 alt="@property.Title"
                                 style="height:220px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height:220px;">
                                <span class="text-muted">
                                    No Photo Available
                                </span>
                            </div>
                        }

                        <!-- PROPERTY INFORMATION -->
                        <div class="card-body">

                            <div class="d-flex justify-content-between mb-2">

                                <span class="badge bg-primary">
                                    @property.ListingType
                                </span>

                                <span class="badge bg-secondary">
                                    @property.PropertyType
                                </span>

                            </div>

                            @if (property.IsFeatured)
                            {
                                <span class="badge bg-warning text-dark mb-2">★ Featured</span>
                            }
                            @if (property.DistanceKm.HasValue)
                            {
                                <span class="badge bg-light text-dark border mb-2">@property.DistanceKm.Value.ToString("F1") km away</span>
                            }
                            @foreach (var keyword in property.MatchedKeywords)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis border mb-2">mentions “@keyword”</span>
                            }

                            <h5 class="card-title fw-bold">
                                @property.Title
                            </h5>

                            <p class="text-muted mb-2">
                                📍 @property.Area, @property.City
                            </p>

                            <h4 class="text-primary fw-bold">
                                @property.Price.ToString("N0")
                                @property.Currency
                            </h4>

                            <hr />

                            <div class="d-flex flex-wrap gap-3 text-muted small">

                                <span>
                                    📐 @property.SizeSquareMeters m²
                                </span>

                                @if (property.Bedrooms.HasValue)
                                {
                                    <span>
                                        🛏 @property.Bedrooms Beds
                                    </span>
                                }

                                @if (property.Bathrooms.HasValue)
                                {
                                    <span>
                                        🚿 @property.Bathrooms Baths
                                    </span>
                                }

                                @if (property.ParkingSpaces > 0)
                                {
                                    <span>🚗 @property.ParkingSpaces Parking</span>
                                }

                                @if (property.IsFurnished)
                                {
                                    <span>🛋 Furnished</span>
                                }

                            </div>

                        </div>

                        <!-- PROPERTY ACTIONS -->
                        <div class="card-footer bg-white border-0 pb-3">

                            <!-- VIEW PROPERTY -->
                            <a asp-controller="Properties"
                               asp-action="Details"
                               asp-route-id="@property.Id"
                               class="btn btn-outline-primary w-100 mb-2">
                                View Details
                            </a>

                            <!-- CHAT BUTTON -->
                            @if (isAuthenticated)
                            {
                                <form asp-controller="Chat"
                                      asp-action="Start"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="propertyListingId"
                                           value="@property.Id" />

                                    <button type="submit"
                                            class="btn btn-primary w-100">

                                        <i class="bi bi-chat-dots me-1"></i>

                                        @(isSale
                                            ? "Chat with Seller"
                                            : "Chat with Landlord")
                                    </button>

                                </form>
                            }
                            else
                            {
                                <a asp-area="Identity"
                                   asp-page="/Account/Login"
                                   asp-route-returnUrl="@Url.Action("Details", "Properties", new { id = property.Id })"
                                   class="btn btn-outline-secondary w-100">

                                    <i class="bi bi-chat-dots me-1"></i>
                                    Log In to Chat

                                </a>
                            }

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>

<!-- SAVE SEARCH MODAL -->
@if (isAuthenticated)
{
    <div class="modal fade"
         id="saveSearchModal"
         tabindex="-1"
         aria-labelledby="saveSearchModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title"
                        id="saveSearchModalLabel">
                        <i class="bi bi-bookmark-plus me-2"></i>
                        Save This Search
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <form id="saveSearchForm"
                      asp-controller="SavedSearches"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="modal-body">

                        <label for="savedSearchName"
                               class="form-label fw-semibold">
                            Search Name
                        </label>

                        <input type="text"
                               id="savedSearchName"
                               name="name"
                               class="form-control"
                               minlength="3"
                               maxlength="100"
                               required
                               placeholder="e.g. Apartments in Beirut" />

                        <p class="text-muted small mt-2 mb-0">
                            Your current search filters will be saved
                            so you can use them again later.
                        </p>

                        <!-- FILTER VALUES -->
                        <input type="hidden" name="listingType" />
                        <input type="hidden" name="propertyType" />
                        <input type="hidden" name="city" />
                        <input type="hidden" name="minPrice" />
                        <input type="hidden" name="maxPrice" />
                        <input type="hidden" name="minBedrooms" />
                        <input type="hidden" name="minBathrooms" />
                        <input type="hidden" name="minSize" />

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-success">
                            <i class="bi bi-bookmark-check me-1"></i>
                            Save Search
                        </button>

                    </div>

                </form>

            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchForm =
                document.getElementById("propertySearchForm");

            const saveForm =
                document.getElementById("saveSearchForm");

            const modal =
                document.getElementById("saveSearchModal");

            if (!searchForm || !saveForm || !modal) {
                return;
            }

            modal.addEventListener("show.bs.modal", function () {
                const filterNames = [
                    "listingType",
                    "propertyType",
                    "city",
                    "minPrice",
                    "maxPrice",
                    "minBedrooms",
                    "minBathrooms",
                    "minSize"
                ];

                filterNames.forEach(function (name) {
                    const source =
                        searchForm.elements.namedItem(name);

                    const target =
                        saveForm.elements.namedItem(name);

                    if (source && target) {
                        target.value = source.value;
                    }
                });
            });
        });
    </script>
}

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const items = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mapItems));
        const form = document.getElementById("propertySearchForm");
        const latInput = document.getElementById("centerLat");
        const lngInput = document.getElementById("centerLng");
        const radius = document.getElementById("radiusKm");

        // Lebanon by default
        const map = L.map("searchMap").setView([33.8547, 35.8623], 8);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 19,
            attribution: "&copy; OpenStreetMap contributors"
        }).addTo(map);

        const esc = s => String(s ?? "").replace(/[&<>"']/g, c =>
            ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

        const bounds = [];
        items.forEach(p => {
            const marker = L.marker([p.lat, p.lng]).addTo(map);
            marker.bindPopup(
                (p.photo ? `<img src="${esc(p.photo)}" style="width:200px;height:120px;object-fit:cover" class="mb-2 rounded"><br>` : "") +
                `<strong>${esc(p.title)}</strong>${p.featured ? " ★" : ""}<br>` +
                `${esc(p.type)} · for ${esc(p.listing.toLowerCase())}<br>` +
                `<span class="text-primary fw-bold">${esc(p.price)}</span><br>` +
                `<span class="text-muted">${esc(p.place)}</span><br>` +
                `<a href="${esc(p.url)}" class="btn btn-sm btn-primary mt-2 text-white">View Details</a>`);
            bounds.push([p.lat, p.lng]);
        });

        // Search center + radius circle
        let centerMarker = null, circle = null;
        function drawCenter(lat, lng) {
            if (centerMarker) map.removeLayer(centerMarker);
            if (circle) map.removeLayer(circle);
            centerMarker = L.circleMarker([lat, lng], { radius: 7, color: "#dc3545" }).addTo(map);
            const km = parseFloat(radius.value);
            if (km) circle = L.circle([lat, lng], { radius: km * 1000, color: "#dc3545", fillOpacity: 0.06 }).addTo(map);
        }

        function setCenter(lat, lng) {
            latInput.value = lat.toFixed(6);
            lngInput.value = lng.toFixed(6);
            if (!radius.value) radius.value = "5";
            form.submit();
        }

        if (latInput.value && lngInput.value) {
            drawCenter(parseFloat(latInput.value), parseFloat(lngInput.value));
            if (circle) map.fitBounds(circle.getBounds());
        } else if (bounds.length) {
            map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
        }

        map.on("click", e => setCenter(e.latlng.lat, e.latlng.lng));

        document.getElementById("useMyLocation").addEventListener("click", () => {
            if (!navigator.geolocation) return alert("Geolocation is not supported by this browser.");
            navigator.geolocation.getCurrentPosition(
                pos => setCenter(pos.coords.latitude, pos.coords.longitude),
                () => alert("Could not get your location."));
        });

        // The map updates when a filter changes.
        form.querySelectorAll("select, input[type=checkbox]").forEach(el =>
            el.addEventListener("change", () => {
                if (el === radius && !radius.value) { latInput.value = ""; lngInput.value = ""; }
                if (el === radius && radius.value && !latInput.value) return; // wait for a point
                form.submit();
            }));
    });
</script>
