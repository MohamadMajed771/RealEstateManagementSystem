
@model IEnumerable<RealEstateMarketplace.Models.Notification>
@using RealEstateMarketplace.Models

@{
    ViewData["Title"] = "My Notifications";

    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="container py-5">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-bell me-2"></i>
                My Notifications
            </h2>

            <p class="text-muted mb-0">
                Stay updated about your properties, messages,
                and saved searches.
            </p>
        </div>

        @if (unreadCount > 0)
        {
            <form asp-controller="Notifications"
                  asp-action="MarkAllAsRead"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-outline-primary">
                    <i class="bi bi-check2-all me-1"></i>
                    Mark All as Read
                </button>
            </form>
        }

    </div>

    <!-- NOTIFICATION COUNT -->
    <div class="mb-4">
        <span class="badge bg-primary">
            @unreadCount Unread
        </span>

        <span class="badge bg-secondary">
            @Model.Count() Total
        </span>
    </div>

    <!-- EMPTY STATE -->
    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">

                <i class="bi bi-bell-slash display-1 text-muted"></i>

                <h4 class="mt-3">No notifications yet</h4>

                <p class="text-muted">
                    When something important happens,
                    your notifications will appear here.
                </p>

                <a asp-controller="Properties"
                   asp-action="Index"
                   class="btn btn-primary mt-2">
                    Browse Properties
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var notification in Model)
            {
                <div class="col-12">

                    <div class="card shadow-sm @(notification.IsRead ? "border-0" : "border-primary")">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start gap-3">

                                <div class="flex-grow-1">

                                    <!-- TYPE ICON -->
                                    @if (notification.Type == NotificationType.SavedSearchMatch)
                                    {
                                        <i class="bi bi-house-check text-success fs-4 me-2"></i>
                                    }
                                    else if (notification.Type == NotificationType.NewMessage)
                                    {
                                        <i class="bi bi-chat-dots text-primary fs-4 me-2"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-bell text-primary fs-4 me-2"></i>
                                    }

                                    <strong class="fs-5">
                                        @notification.Title
                                    </strong>

                                    @if (!notification.IsRead)
                                    {
                                        <span class="badge bg-primary ms-2">
                                            New
                                        </span>
                                    }

                                    <p class="mt-2 mb-2">
                                        @notification.Message
                                    </p>

                                    <small class="text-muted">
                                        @notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                    </small>

                                    <!-- RELATED PROPERTY / ACTION -->
                                    @if (!string.IsNullOrWhiteSpace(notification.ActionUrl)
                                         && notification.ActionUrl.StartsWith("/")
                                         && !notification.ActionUrl.StartsWith("//")
                                         && !notification.ActionUrl.StartsWith("/\\"))
                                    {
                                        <div class="mt-3">
                                            <a href="@notification.ActionUrl"
                                               class="btn btn-sm btn-outline-primary">
                                                View Details
                                            </a>
                                        </div>
                                    }

                                </div>

                                <!-- ACTIONS -->
                                <div class="d-flex flex-column gap-2">

                                    @if (!notification.IsRead)
                                    {
                                        <form asp-controller="Notifications"
                                              asp-action="MarkAsRead"
                                              asp-route-id="@notification.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success w-100">
                                                <i class="bi bi-check2"></i>
                                                Mark Read
                                            </button>

                                        </form>
                                    }

                                    <form asp-controller="Notifications"
                                          asp-action="Delete"
                                          asp-route-id="@notification.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger w-100"
                                                onclick="return confirm('Delete this notification?');">
                                            <i class="bi bi-trash"></i>
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>
