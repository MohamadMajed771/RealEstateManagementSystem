
@model IEnumerable<RealEstateMarketplace.Models.SavedSearch>

@{
    ViewData["Title"] = "My Saved Searches";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-bookmark-heart me-2"></i>
                My Saved Searches
            </h2>

            <p class="text-muted mb-0">
                Quickly repeat your favorite property searches.
            </p>
        </div>

        <a asp-controller="Properties"
           asp-action="Index"
           class="btn btn-primary">
            <i class="bi bi-search me-1"></i>
            Browse Properties
        </a>

    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Empty State -->
    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">

                <i class="bi bi-bookmark display-1 text-muted"></i>

                <h4 class="mt-3">
                    No saved searches yet
                </h4>

                <p class="text-muted">
                    Search for properties and save your filters
                    to use them again later.
                </p>

                <a asp-controller="Properties"
                   asp-action="Index"
                   class="btn btn-primary mt-2">
                    Explore Properties
                </a>

            </div>
        </div>
    }
    else
    {
        <p class="text-muted">
            You have @Model.Count() saved searches.
        </p>

        <div class="row g-4">

            @foreach (var search in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body">

                            <h5 class="card-title fw-bold">
                                <i class="bi bi-bookmark-fill text-primary me-1"></i>
                                @search.Name
                            </h5>

                            <p class="text-muted small">
                                Saved on @search.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                            </p>

                            <hr />

                            <div class="mb-2">
                                <strong>Listing Type:</strong>
                                @(search.ListingType?.ToString() ?? "Any")
                            </div>

                            <div class="mb-2">
                                <strong>Property Type:</strong>
                                @(search.PropertyType?.ToString() ?? "Any")
                            </div>

                            <div class="mb-2">
                                <strong>City:</strong>
                                @(search.City ?? "Any")
                            </div>

                            <div class="mb-2">
                                <strong>Price:</strong>
                                @(search.MinPrice?.ToString("N0") ?? "Any")
                                -
                                @(search.MaxPrice?.ToString("N0") ?? "Any")
                            </div>

                            <div class="mb-2">
                                <strong>Minimum Bedrooms:</strong>
                                @(search.MinBedrooms?.ToString() ?? "Any")
                            </div>

                            <div class="mb-2">
                                <strong>Minimum Bathrooms:</strong>
                                @(search.MinBathrooms?.ToString() ?? "Any")
                            </div>

                            <div class="mb-2">
                                <strong>Minimum Size:</strong>
                                @(search.MinSizeSquareMeters?.ToString("N0") ?? "Any")
                                m²
                            </div>

                        </div>

                        <div class="card-footer bg-white border-0 pb-3">

                            <!-- Run Saved Search -->
                            <a asp-controller="SavedSearches"
                               asp-action="Run"
                               asp-route-id="@search.Id"
                               class="btn btn-primary w-100 mb-2">

                                <i class="bi bi-search me-1"></i>
                                Search Again
                            </a>

                            <!-- Delete Saved Search -->
                            <form asp-controller="SavedSearches"
                                  asp-action="Delete"
                                  asp-route-id="@search.Id"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-outline-danger w-100"
                                        onclick="return confirm('Are you sure you want to delete this saved search?');">

                                    <i class="bi bi-trash me-1"></i>
                                    Delete Search
                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
