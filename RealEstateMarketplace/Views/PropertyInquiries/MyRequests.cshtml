
@model List<RealEstateMarketplace.Models.PropertyInquiry>
@using RealEstateMarketplace.Models

@{
    ViewData["Title"] = "My Property Requests";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">My Property Requests</h2>

        <p class="text-muted">
            Track your rental and purchase requests.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have not submitted any property requests yet.
        </div>

        <a asp-controller="Properties"
           asp-action="Index"
           class="btn btn-primary">
            Browse Properties
        </a>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Property</th>
                        <th>Owner</th>
                        <th>Request Type</th>
                        <th>Status</th>
                        <th>Submitted At</th>
                        <th>Response</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var inquiry in Model)
                    {
                        <tr>
                            <td>
                                <strong>
                                    @inquiry.PropertyListing.Title
                                </strong>

                                <div class="mt-1">
                                    <a asp-controller="Properties"
                                       asp-action="Details"
                                       asp-route-id="@inquiry.PropertyListingId"
                                       class="small">
                                        View Property
                                    </a>
                                </div>
                            </td>

                            <td>
                                @inquiry.Owner.FirstName
                                @inquiry.Owner.LastName
                            </td>

                            <td>
                                @if (inquiry.RequestType == ListingType.Rent)
                                {
                                    <span class="badge bg-info text-dark">
                                        Rent
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">
                                        Buy
                                    </span>
                                }
                            </td>

                            <td>
                                @switch (inquiry.Status)
                                {
                                    case PropertyInquiryStatus.Pending:
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                        break;

                                    case PropertyInquiryStatus.Accepted:
                                        <span class="badge bg-success">
                                            Accepted
                                        </span>
                                        break;

                                    case PropertyInquiryStatus.Rejected:
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                        break;

                                    case PropertyInquiryStatus.Cancelled:
                                        <span class="badge bg-secondary">
                                            Cancelled
                                        </span>
                                        break;
                                }
                            </td>

                            <td>
                                @inquiry.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                <span class="small text-muted">UTC</span>
                            </td>

                            <td>
                                @if (inquiry.Status == PropertyInquiryStatus.Accepted)
                                {
                                    <span class="text-success">
                                        Your request was accepted!
                                    </span>
                                }
                                else if (inquiry.Status == PropertyInquiryStatus.Rejected)
                                {
                                    <span class="text-danger">
                                        Your request was rejected.
                                    </span>
                                }
                                else if (inquiry.Status == PropertyInquiryStatus.Pending)
                                {
                                    <span class="text-muted">
                                        Waiting for owner response.
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Request cancelled.
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>
