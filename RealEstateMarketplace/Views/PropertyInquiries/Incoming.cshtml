
@model List<RealEstateMarketplace.Models.PropertyInquiry>
@using RealEstateMarketplace.Models

@{
    ViewData["Title"] = "Incoming Property Requests";

    var pendingCount = Model.Count(i =>
        i.Status == PropertyInquiryStatus.Pending);
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold">
                Incoming Property Requests
            </h2>

            <p class="text-muted mb-0">
                Manage rental and purchase requests for your properties.
            </p>
        </div>

        <div>
            <span class="badge bg-warning text-dark fs-6">
                @pendingCount Pending
            </span>
        </div>

    </div>

    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Empty State -->
    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have not received any property requests yet.
        </div>
    }
    else
    {
        <!-- Requests Table -->
        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Property</th>
                        <th>Requested By</th>
                        <th>Request Type</th>
                        <th>Status</th>
                        <th>Requested At</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var inquiry in Model)
                    {
                        <tr>

                            <!-- Property -->
                            <td>
                                <strong>
                                    @inquiry.PropertyListing.Title
                                </strong>

                                <div class="mt-1">
                                    <a asp-controller="Properties"
                                       asp-action="Details"
                                       asp-route-id="@inquiry.PropertyListingId"
                                       asp-route-from="incoming"
                                       class="small">
                                        View Property
                                    </a>
                                </div>
                            </td>

                            <!-- Requester -->
                            <td>
                                <strong>
                                    @inquiry.Requester.FirstName
                                    @inquiry.Requester.LastName
                                </strong>

                                <div class="small text-muted">
                                    @inquiry.Requester.Email
                                </div>
                            </td>

                            <!-- Request Type -->
                            <td>
                                @if (inquiry.RequestType == ListingType.Rent)
                                {
                                    <span class="badge bg-info text-dark">
                                        Rent
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">
                                        Buy
                                    </span>
                                }
                            </td>

                            <!-- Status -->
                            <td>
                                @switch (inquiry.Status)
                                {
                                    case PropertyInquiryStatus.Pending:
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                        break;

                                    case PropertyInquiryStatus.Accepted:
                                        <span class="badge bg-success">
                                            Accepted
                                        </span>
                                        break;

                                    case PropertyInquiryStatus.Rejected:
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                        break;

                                    case PropertyInquiryStatus.Cancelled:
                                        <span class="badge bg-secondary">
                                            Cancelled
                                        </span>
                                        break;
                                }
                            </td>

                            <!-- Date -->
                            <td>
                                @inquiry.CreatedAt.ToString("yyyy-MM-dd HH:mm")

                                <span class="small text-muted">
                                    UTC
                                </span>
                            </td>

                            <!-- Actions -->
                            <td>
                                @if (inquiry.Status == PropertyInquiryStatus.Pending)
                                {
                                    <div class="d-flex flex-wrap gap-2">

                                        <!-- Accept -->
                                        <form asp-controller="PropertyInquiries"
                                              asp-action="Accept"
                                              asp-route-id="@inquiry.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-success btn-sm"
                                                    onclick="return confirm('Are you sure you want to accept this request?');">
                                                Accept
                                            </button>

                                        </form>

                                        <!-- Reject -->
                                        <form asp-controller="PropertyInquiries"
                                              asp-action="Reject"
                                              asp-route-id="@inquiry.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Are you sure you want to reject this request?');">
                                                Reject
                                            </button>

                                        </form>

                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        Request processed
                                    </span>
                                }
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
