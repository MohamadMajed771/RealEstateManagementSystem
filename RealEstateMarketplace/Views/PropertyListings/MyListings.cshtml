
@model IEnumerable<RealEstateMarketplace.Models.PropertyListing>

@{
    ViewData["Title"] = "My Listings";
}

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Property Listings</h2>

        <a asp-controller="PropertyListings"
           asp-action="Create"
           class="btn btn-primary">
            + Add New Property
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have not created any property listings yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Property Type</th>
                        <th>Location</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var listing in Model)
                    {
                        <tr>
                            <td>@listing.Title</td>
                            <td>@listing.Property.Type</td>
                            <td>
                                @listing.Property.Area,
                                @listing.Property.City,
                                @listing.Property.Country
                            </td>
                            <td>
                                @listing.Price.ToString("N2")
                                @listing.Currency
                            </td>
                            <td>
                                @listing.Status
                            </td>
                            <td>
                                @listing.CreatedAt.ToString("yyyy-MM-dd")
                            </td>
                            
                            
                            <td>
                                <div class="d-flex gap-2">

                                    <!-- Edit button -->
                                    <a asp-controller="PropertyListings"
                                       asp-action="Edit"
                                       asp-route-id="@listing.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <!-- Delete button -->
                                    <form asp-controller="PropertyListings"
                                          asp-action="Delete"
                                          asp-route-id="@listing.Id"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this property listing?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>
                                    </form>

                                </div>
                            </td>


                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
