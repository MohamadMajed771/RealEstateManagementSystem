@model RealEstateMarketplace.ViewModels.IListingExtraFields

@* Shared by Create and Edit. Section is chosen with ViewData["Section"]. *@

@if ((string?)ViewData["Section"] == "facilities")
{
    <h6 class="mt-2 mb-3">Facilities</h6>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="ParkingSpaces" class="form-label"></label>
            <input asp-for="ParkingSpaces" type="number" min="0" max="100" class="form-control" />
            <span asp-validation-for="ParkingSpaces" class="text-danger"></span>
        </div>
        <div class="col-md-8 mb-3 d-flex flex-wrap gap-3 align-items-end">
            @foreach (var name in new[] { "IsFurnished", "HasBalcony", "HasGarden", "HasTerrace" })
            {
                <div class="form-check">
                    @Html.CheckBox(name, new { @class = "form-check-input" })
                    @Html.Label(name, null, new { @class = "form-check-label" })
                </div>
            }
        </div>
        <div class="col-12 mb-3">
            <label asp-for="OtherFacilities" class="form-label"></label>
            <input asp-for="OtherFacilities" class="form-control"
                   placeholder="Example: elevator, generator, sea view, solar panels" />
            <span asp-validation-for="OtherFacilities" class="text-danger"></span>
        </div>
    </div>
}
else
{
    <div class="row" id="listing-terms">
        <div class="col-md-6 mb-3" data-for="Rent">
            <label asp-for="RentalPeriodMonths" class="form-label"></label>
            <select asp-for="RentalPeriodMonths" class="form-select">
                <option value="">Flexible</option>
                <option value="3">3 months</option>
                <option value="6">6 months</option>
                <option value="12">12 months</option>
                <option value="24">24 months</option>
            </select>
        </div>
        <div class="col-md-6 mb-3 d-flex align-items-end" data-for="Sale">
            <div class="form-check">
                <input asp-for="InstallmentsAccepted" class="form-check-input" />
                <label asp-for="InstallmentsAccepted" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-md-6 mb-3" data-for="Sale">
            <label asp-for="InstallmentMonths" class="form-label"></label>
            <input asp-for="InstallmentMonths" type="number" min="1" max="360" class="form-control"
                   placeholder="Example: 60" />
            <span asp-validation-for="InstallmentMonths" class="text-danger"></span>
            <div class="form-text">Listing information only. The marketplace does not provide financing.</div>
        </div>
    </div>

    <script>
        // Show rental period for Rent, installments for Sale.
        (function () {
            const select = document.querySelector('[name="ListingType"]');
            const box = document.getElementById('listing-terms');
            if (!select || !box) return;
            const sync = () => {
                const type = select.options[select.selectedIndex]?.text?.trim() === 'Rent' || select.value === 'Rent' || select.value === '2'
                    ? 'Rent' : (select.value ? 'Sale' : '');
                box.querySelectorAll('[data-for]').forEach(el =>
                    el.style.display = (!type || el.dataset.for === type) ? '' : 'none');
            };
            select.addEventListener('change', sync);
            sync();
        })();
    </script>
}
