@model RealEstateMarketplace.ViewModels.CreatePropertyListingViewModel

@{
    ViewData["Title"] = "Create Property Listing";
}

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Create Property Listing</h3>
                </div>

                <div class="card-body p-4">
                    <form asp-controller="PropertyListings"
                      asp-action="Create"
                      method="post"
                      enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <h5 class="mb-3">Property Information</h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Type"
                                       class="form-label"></label>
                                <select asp-for="Type"
                                        asp-items="Html.GetEnumSelectList<RealEstateMarketplace.Models.PropertyType>()"
                                        class="form-select">
                                    <option value="">Select property type</option>
                                </select>
                                <span asp-validation-for="Type"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ListingType"
                                       class="form-label"></label>
                                <select asp-for="ListingType"
                                        asp-items="Html.GetEnumSelectList<RealEstateMarketplace.Models.ListingType>()"
                                        class="form-select">
                                    <option value="">Select sale or rent</option>
                                </select>
                                <span asp-validation-for="ListingType"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <h5 class="mt-3 mb-2">Property Address</h5>
                        <p class="text-muted">
                            Enter an address to find it on the map,
                            or select a location directly on the map
                            to fill the address automatically.
                        </p>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Country"
                                       class="form-label"></label>
                                <input asp-for="Country"
                                       class="form-control" />
                                <span asp-validation-for="Country"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="City"
                                       class="form-label"></label>
                                <input asp-for="City"
                                       class="form-control" />
                                <span asp-validation-for="City"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Area"
                                       class="form-label"></label>
                                <input asp-for="Area"
                                       class="form-control" />
                                <span asp-validation-for="Area"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StreetAddress"
                                   class="form-label"></label>
                            <input asp-for="StreetAddress"
                                   class="form-control" />
                            <span asp-validation-for="StreetAddress"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <button type="button" id="gpsLocationButton" class="btn btn-outline-success me-2">
                                <i class="bi bi-geo-alt"></i> Use my current location (GPS)
                            </button>
                            <button type="button"
                                    id="findOnMapButton"
                                    class="btn btn-outline-primary">
                                Find Address on Map
                            </button>

                            <div id="mapSearchStatus"
                                 class="small text-muted mt-2"
                                 role="status"
                                 aria-live="polite"></div>
                        </div>

                        <h5 class="mb-2">Select Property Location</h5>
                        <p class="text-muted">
                            Click the exact property location on the map.
                            You can drag the marker to adjust it.
                        </p>

                        <div id="propertyMap"
                             style="height:450px;
                            width:100%;
                            border:1px solid #dee2e6;
                            border-radius:8px;
                            overflow:hidden;
                            position:relative;">
                        </div>

                        <input asp-for="Latitude" type="hidden" />
                        <input asp-for="Longitude" type="hidden" />

                        <span asp-validation-for="Latitude"
                              class="text-danger d-block"></span>
                        <span asp-validation-for="Longitude"
                              class="text-danger d-block"></span>

                        <div class="alert alert-secondary mt-3">
                            <strong>Selected coordinates:</strong>
                            <span id="selectedCoordinates">
                                No location selected yet.
                            </span>
                        </div>

                        <hr class="my-4" />

                        <h5 class="mb-3">Property Details</h5>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="SizeSquareMeters"
                                       class="form-label"></label>
                                <input asp-for="SizeSquareMeters"
                                       type="number"
                                       step="0.01"
                                       min="0.01"
                                       class="form-control" />
                                <span asp-validation-for="SizeSquareMeters"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Bedrooms"
                                       class="form-label"></label>
                                <input asp-for="Bedrooms"
                                       type="number"
                                       min="0"
                                       class="form-control" />
                                <span asp-validation-for="Bedrooms"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Bathrooms"
                                       class="form-label"></label>
                                <input asp-for="Bathrooms"
                                       type="number"
                                       min="0"
                                       class="form-control" />
                                <span asp-validation-for="Bathrooms"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <partial name="_ListingExtraFields" model="Model" view-data='new ViewDataDictionary(ViewData) { ["Section"] = "facilities" }' />

                        <hr class="my-4" />

                        <h5 class="mb-3">Advertisement Details</h5>

                        <div class="mb-3">
                            <label asp-for="Title"
                                   class="form-label"></label>
                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="Example: Modern apartment in Beirut" />
                            <span asp-validation-for="Title"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description"
                                   class="form-label"></label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Price"
                                       class="form-label"></label>
                                <input asp-for="Price"
                                       type="number"
                                       step="0.01"
                                       min="0.01"
                                       class="form-control" />
                                <span asp-validation-for="Price"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Currency"
                                       class="form-label"></label>
                                <select asp-for="Currency"
                                        class="form-select">
                                    <option value="USD">USD</option>
                                    <option value="EUR">EUR</option>
                                    <option value="LBP">LBP</option>
                                </select>
                                <span asp-validation-for="Currency"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <partial name="_ListingExtraFields" model="Model" view-data='new ViewDataDictionary(ViewData) { ["Section"] = "terms" }' />

                        
                        <hr class="my-4" />

                        <h5 class="mb-3">Property Photos</h5>

                        <p class="text-muted">
                            Upload up to 10 photos of your property.
                            Supported formats: JPG, JPEG, PNG, WebP.
                            Maximum size: 5 MB per photo.
                        </p>

                        <div class="mb-3">
                            <label asp-for="Photos" class="form-label"></label>

                            <input asp-for="Photos"
                                   type="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                   multiple />

                            <span asp-validation-for="Photos"
                                  class="text-danger"></span>

                            <div id="photoValidationMessage"
                                 class="text-danger mt-2"
                                 role="alert"></div>
                        </div>

                        <div id="photoPreviewContainer"
                             class="row g-3 mt-2"></div>


                        <div class="alert alert-info mt-3">
                            Your listing will be submitted for approval
                            before it becomes public.
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit"
                                    class="btn btn-success">
                                Submit Listing
                            </button>

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const fields = {
                country: document.getElementById("Country"),
                city: document.getElementById("City"),
                area: document.getElementById("Area"),
                street: document.getElementById("StreetAddress"),
                latitude: document.getElementById("Latitude"),
                longitude: document.getElementById("Longitude")
            };

            const status = document.getElementById("mapSearchStatus");
            const coordinates = document.getElementById("selectedCoordinates");
            const searchButton = document.getElementById("findOnMapButton");

            if (typeof L === "undefined") {
                status.textContent = "Map library failed to load.";
                return;
            }

            const map = L.map("propertyMap").setView(
                [33.8547, 35.8623], 9
            );

            L.tileLayer(
                "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                {
                    attribution: '&copy; OpenStreetMap contributors',
                    maxZoom: 19
                }
            ).addTo(map);

            let marker = null;
            let reverseRequestId = 0;

            function revalidate(input) {
                if (window.jQuery &&
                    jQuery.validator &&
                    jQuery.validator.unobtrusive) {
                    jQuery(input).valid();
                }
            }

            function setField(input, value) {
                input.value = value || "";
                revalidate(input);
            }

            function setCoordinates(lat, lng) {
                if (!marker) {
                    marker = L.marker([lat, lng], {
                        draggable: true
                    }).addTo(map);

                    marker.on("dragend", function () {
                        const position = marker.getLatLng();
                        selectLocation(position.lat, position.lng);
                    });
                } else {
                    marker.setLatLng([lat, lng]);
                }

                fields.latitude.value = lat.toFixed(7);
                fields.longitude.value = lng.toFixed(7);

                coordinates.textContent =
                    lat.toFixed(7) + ", " + lng.toFixed(7);

                revalidate(fields.latitude);
                revalidate(fields.longitude);
            }

            async function selectLocation(lat, lng) {
                setCoordinates(lat, lng);

                const requestId = ++reverseRequestId;
                status.textContent = "Detecting address...";

                try {
                    const url = new URL(
                        "https://nominatim.openstreetmap.org/reverse"
                    );

                    url.searchParams.set("lat", lat);
                    url.searchParams.set("lon", lng);
                    url.searchParams.set("format", "json");
                    url.searchParams.set("addressdetails", "1");

                    const response = await fetch(url);

                    if (!response.ok) {
                        throw new Error("Address lookup failed.");
                    }

                    const data = await response.json();

                    if (requestId !== reverseRequestId) return;

                    const address = data.address || {};

                    
                    console.log("Full Nominatim response:", data);
                    console.log("Address fields:", address);
                    console.table(address);


                    const city =
                        address.city ||
                        address.town ||
                        address.village ||
                        address.municipality ||
                        "";

                    
                    const area =
                        address.neighbourhood ||
                        address.suburb ||
                        address.quarter ||
                        address.city_district ||
                        address.residential ||
                        address.hamlet ||
                        address.locality ||
                        address.isolated_dwelling ||
                        "";


                    const street =
                        address.road ||
                        address.pedestrian ||
                        address.residential ||
                        "";

                    if (address.country) {
                        setField(fields.country, address.country);
                    }

                    if (city) {
                        setField(fields.city, city);
                    }

                    
                    setField(fields.area, area);
                    setField(fields.street, street);


                    status.textContent =
                        "Address detected. Please verify the fields.";
                }
                catch (error) {
                    console.error(error);
                    if (requestId === reverseRequestId) {
                        status.textContent =
                            "Location selected. Enter or verify the address manually.";
                    }
                }
            }

            // GPS: the owner is at the property and uses the device location.
            document.getElementById("gpsLocationButton").addEventListener("click", function () {
                if (!navigator.geolocation) {
                    status.textContent = "Your browser does not support location detection. Click the map instead.";
                    return;
                }
                status.textContent = "Detecting your current location...";
                navigator.geolocation.getCurrentPosition(function (pos) {
                    const lat = pos.coords.latitude, lng = pos.coords.longitude;
                    map.setView([lat, lng], 17);
                    selectLocation(lat, lng);
                }, function () {
                    status.textContent = "Location permission was denied or unavailable. Click the map or search the address instead.";
                }, { enableHighAccuracy: true, timeout: 15000 });
            });

            map.on("click", function (event) {
                selectLocation(event.latlng.lat, event.latlng.lng);
            });

            searchButton.addEventListener("click", async function () {
                const country = fields.country.value.trim();
                const city = fields.city.value.trim();
                const area = fields.area.value.trim();
                const street = fields.street.value.trim();

                if (!country && !city && !area && !street) {
                    status.textContent = "Enter an address first.";
                    return;
                }

                const query = [street, area, city, country]
                    .filter(Boolean)
                    .join(", ");

                searchButton.disabled = true;
                status.textContent = "Searching for address...";

                try {
                    const url = new URL(
                        "https://nominatim.openstreetmap.org/search"
                    );

                    url.searchParams.set("q", query);
                    url.searchParams.set("format", "json");
                    url.searchParams.set("limit", "1");

                    const response = await fetch(url);

                    if (!response.ok) {
                        throw new Error("Search failed.");
                    }

                    const results = await response.json();

                    if (results.length === 0) {
                        status.textContent =
                            "Address not found. Try a broader search.";
                        return;
                    }

                    const result = results[0];
                    const bounds = result.boundingbox.map(Number);

                    
                    const lat = parseFloat(result.lat);
                    const lng = parseFloat(result.lon);

                    let zoomLevel = 9;

                    if (city) {
                        zoomLevel = 13;
                    }

                    if (area) {
                        zoomLevel = 15;
                    }

                    if (street) {
                        zoomLevel = 17;
                    }

                    map.setView([lat, lng], zoomLevel, {
                        animate: true
                    });


                    status.textContent =
                        "Address found. Click the exact property location on the map.";

                    // Do not replace the exact marker with
                    // the approximate search result.
                }
                catch (error) {
                    console.error(error);
                    status.textContent =
                        "Unable to search right now. Try again.";
                }
                finally {
                    searchButton.disabled = false;
                }
            });

            // Restore coordinates after validation errors.
            const existingLat = parseFloat(fields.latitude.value);
            const existingLng = parseFloat(fields.longitude.value);

            if (
                fields.latitude.value !== "" &&
                fields.longitude.value !== "" &&
                Number.isFinite(existingLat) &&
                Number.isFinite(existingLng)
            ) {
                setCoordinates(existingLat, existingLng);
                map.setView([existingLat, existingLng], 16);
            }

            // Correct map sizing after layout is complete.
            setTimeout(function () {
                map.invalidateSize();
            }, 200);
        });
    </script>
    
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const photoInput = document.getElementById("Photos");
        const previewContainer =
            document.getElementById("photoPreviewContainer");
        const validationMessage =
            document.getElementById("photoValidationMessage");

        const maxPhotos = 10;
        const maxFileSize = 5 * 1024 * 1024;

        const allowedTypes = [
            "image/jpeg",
            "image/png",
            "image/webp"
        ];

        photoInput.addEventListener("change", function () {

            previewContainer.innerHTML = "";
            validationMessage.textContent = "";

            const files = Array.from(photoInput.files);

            if (files.length > maxPhotos) {
                validationMessage.textContent =
                    "You can upload a maximum of 10 photos.";

                photoInput.value = "";
                return;
            }

            for (const file of files) {

                if (!allowedTypes.includes(file.type)) {
                    validationMessage.textContent =
                        "Only JPG, JPEG, PNG and WebP images are allowed.";

                    photoInput.value = "";
                    previewContainer.innerHTML = "";
                    return;
                }

                if (file.size === 0 || file.size > maxFileSize) {
                    validationMessage.textContent =
                        "Each photo must be non-empty and 5 MB or smaller.";

                    photoInput.value = "";
                    previewContainer.innerHTML = "";
                    return;
                }
            }

            files.forEach(function (file, index) {

                const reader = new FileReader();

                reader.onload = function (event) {

                    const column = document.createElement("div");
                    column.className = "col-md-3 col-sm-6";

                    const card = document.createElement("div");
                    card.className = "card h-100";

                    const image = document.createElement("img");
                    image.src = event.target.result;
                    image.className = "card-img-top";
                    image.alt = "Property photo preview";
                    image.style.height = "150px";
                    image.style.objectFit = "cover";

                    const body = document.createElement("div");
                    body.className = "card-body p-2";

                    const caption = document.createElement("small");
                    caption.className = "text-muted";
                    caption.textContent =
                        (index + 1) + ". " + file.name;

                    body.appendChild(caption);
                    card.appendChild(image);
                    card.appendChild(body);
                    column.appendChild(card);
                    previewContainer.appendChild(column);
                };

                reader.readAsDataURL(file);
            });
        });
    });
</script>

}
