@page
@model RealEstateMarketplace.Areas.Identity.Pages.Account.VerifyEmailModel
@{ ViewData["Title"] = "Verify your email"; }

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="text-center mb-3">Verify your email</h2>

                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <div class="alert alert-info">@Model.Message</div>
                    }

                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Code" class="form-label"></label>
                            <input asp-for="Code" class="form-control form-control-lg text-center"
                                   inputmode="numeric" autocomplete="one-time-code" maxlength="7"
                                   placeholder="123456" style="letter-spacing:6px" autofocus />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>
                        <button class="btn btn-primary w-100 mb-2">Verify</button>
                        <button class="btn btn-link w-100" asp-page-handler="Resend" formnovalidate>
                            Send me a new code
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
