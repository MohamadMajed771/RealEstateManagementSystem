@model IEnumerable<RealEstateMarketplace.Models.PropertyListing>

@{
    ViewData["Title"] = "Pending Property Listings";
}

<style>
    .listings-page {
        max-width: 1250px;
        margin: 30px auto;
        padding: 0 20px;
        font-family: 'Segoe UI', Arial, sans-serif;
    }

    .listings-header {
        background: #142b49;
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

        .listings-header h1 {
            margin: 0 0 8px;
            font-size: 27px;
        }

        .listings-header p {
            margin: 0;
            color: #cbd5e1;
        }

    .listings-table-wrapper {
        overflow-x: auto;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
    }

    .listings-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .listings-table th,
        .listings-table td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
        }

        .listings-table th {
            background: #f1f5f9;
            color: #334155;
        }

    .pending-badge {
        background: #fef3c7;
        color: #92400e;
        padding: 6px 10px;
        border-radius: 20px;
        font-weight: 600;
        white-space: nowrap;
    }

    .review-button {
        display: inline-block;
        padding: 9px 14px;
        background: #2563eb;
        color: white;
        border-radius: 7px;
        text-decoration: none;
    }

        .review-button:hover {
            background: #1d4ed8;
            color: white;
        }

    .empty-message {
        padding: 30px;
        text-align: center;
        color: #64748b;
    }
</style>

<div class="listings-page">

    <div class="listings-header">
        <h1>Pending Property Listings</h1>
        <p>Review properties submitted by marketplace users.</p>
    </div>

    <div class="listings-table-wrapper">

        @if (!Model.Any())
        {
            <div class="empty-message">
                No properties are currently waiting for approval.
            </div>
        }
        else
        {
            <table class="listings-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Property</th>
                        <th>Owner</th>
                        <th>Location</th>
                        <th>Price</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var listing in Model)
                    {
                        <tr>
                            <td>@listing.Id</td>

                            <td>
                                <strong>@listing.Title</strong>
                                <div>@listing.ListingType</div>
                            </td>

                            <td>
                                @listing.Property.Owner.FirstName
                                @listing.Property.Owner.LastName
                            </td>

                            <td>
                                @listing.Property.City,
                                @listing.Property.Area
                            </td>

                            <td>
                                @listing.Price.ToString("N2")
                                @listing.Currency
                            </td>

                            <td>
                                @listing.CreatedAt.ToString("yyyy-MM-dd")
                            </td>

                            <td>
                                <span class="pending-badge">
                                    Pending
                                </span>
                            </td>

                            
                            <td>
                                <a href="@Url.Content($"~/Admin/Listings/Details/{listing.Id}")"
                                   class="review-button">
                                    Review
                                </a>
                            </td>


                        </tr>
                    }
                </tbody>
            </table>
        }

    </div>

</div>
