@model List<PropertyReport>
@using RealEstateMarketplace.Areas.Admin.Controllers
@{
    ViewData["Title"] = "Property Reports";
    var counts = ViewBag.ReportCounts as Dictionary<int, int> ?? new();
    bool showClosed = ViewBag.ShowClosed == true;
}

<div class="container-xl py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Property Reports</h2>
        <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-success" href="~/Admin/Export/Reports?format=xlsx">Excel</a>
        <a class="btn btn-sm btn-outline-danger" href="~/Admin/Export/Reports?format=pdf">PDF</a>
        <a class="btn btn-sm btn-outline-secondary" href="?showClosed=@(!showClosed)">
            @(showClosed ? "Show open only" : "Show closed reports too")
        </a>
        </div>
    </div>

    <partial name="_AdminAlerts" />

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No @(showClosed ? "" : "open ")reports.</div>
    }

    @foreach (var r in Model)
    {
        var listing = r.PropertyListing;
        var open = r.Status is PropertyReportStatus.Pending or PropertyReportStatus.UnderReview;

        <div class="card mb-3 @(open ? "" : "opacity-75")">
            <div class="card-body">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <div>
                        <span class="badge bg-danger">@r.Reason</span>
                        <span class="badge bg-secondary">@r.Status</span>
                        @if (counts.TryGetValue(r.PropertyListingId, out var n) && n > 1)
                        {
                            <span class="badge bg-warning text-dark">@n reports on this listing</span>
                        }
                        <h5 class="mt-2 mb-1">
                            <a href="@Url.Content($"~/Properties/Details/{listing.Id}")" target="_blank" class="text-decoration-none">
                                #@listing.Id @listing.Title
                            </a>
                        </h5>
                        <div class="small text-muted">
                            Owner: @listing.Property.Owner.FirstName @listing.Property.Owner.LastName (@listing.Property.Owner.Email)
                            · listing status: @listing.Status@(listing.IsDeleted ? " (removed)" : "")
                        </div>
                    </div>
                    <div class="small text-muted text-end">
                        Reported by @r.ReportedByUser.Email<br />
                        @r.CreatedAt.ToLocalTime().ToString("g")
                    </div>
                </div>

                <p class="mt-3 mb-2" style="white-space:pre-line">@r.Description</p>

                @if (!open)
                {
                    <div class="small text-muted">
                        Decision by @(r.ReviewedByUser?.Email ?? "admin") on @r.ReviewedAt?.ToLocalTime().ToString("g"):
                        @r.ModeratorNotes
                    </div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2 align-items-start mt-3">
                        @if (r.Status == PropertyReportStatus.Pending)
                        {
                            <form asp-action="Investigate" asp-route-id="@r.Id" method="post">
                                <button class="btn btn-sm btn-outline-primary">Mark as under investigation</button>
                            </form>
                        }
                        <a class="btn btn-sm btn-outline-secondary" target="_blank"
                           href="@Url.Content($"~/Properties/Details/{listing.Id}")">Open public page</a>
                    </div>

                    <form asp-action="Resolve" asp-route-id="@r.Id" method="post" class="row g-2 mt-2">
                        <div class="col-md-4">
                            <select name="decision" class="form-select form-select-sm">
                                <option value="@ReportsController.ReportAction.Dismiss">Dismiss (listing is valid)</option>
                                <option value="@ReportsController.ReportAction.RequestCorrections">Request corrections from owner</option>
                                <option value="@ReportsController.ReportAction.HideListing">Hide listing</option>
                                <option value="@ReportsController.ReportAction.RemoveListing">Remove listing</option>
                                <option value="@ReportsController.ReportAction.SuspendOwner">Suspend owner account</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <input name="notes" class="form-control form-control-sm" maxlength="2000"
                                   placeholder="Decision note (sent to the owner when action is taken)" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-sm btn-danger w-100"
                                    onclick="return confirm('Record this decision?');">Record decision</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    }
</div>
