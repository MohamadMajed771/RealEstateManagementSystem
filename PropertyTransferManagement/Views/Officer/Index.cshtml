@model List<TransferCase>
@{
    ViewData["Title"] = "My Assigned Cases";
    var pendingReview = ViewBag.PendingReviewByCase as Dictionary<Guid, int> ?? new();

    int Count(params TransferCaseStatus[] statuses) => Model.Count(c => statuses.Contains(c.Status));

    var tiles = new (string Label, int Value)[]
    {
        ("Assigned cases", Model.Count),
        ("New applications", Count(TransferCaseStatus.RequestReceived)),
        ("Awaiting document review", Model.Count(c => pendingReview.ContainsKey(c.Id))),
        ("Waiting for user action", Count(TransferCaseStatus.AwaitingDocuments, TransferCaseStatus.AdditionalInformationRequired)),
        ("Ready for external processing", Count(TransferCaseStatus.ReadyForProcessing)),
        ("Completed", Count(TransferCaseStatus.OfficialCompletionConfirmed, TransferCaseStatus.CaseClosed))
    };
}

<h2 class="mb-3">My Assigned Cases</h2>

<partial name="_Alerts" />

<div class="row g-3 mb-4">
    @foreach (var (label, value) in tiles)
    {
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card h-100">
                <div class="card-body">
                    <div class="small text-muted">@label</div>
                    <div class="fs-3 fw-semibold">@value</div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No cases are assigned to you yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Case</th><th>Property</th><th>Buyer</th><th>Seller</th>
                    <th>Status</th><th>To review</th><th>Updated</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.CaseNumber</td>
                        <td>@c.PropertyTitle<div class="small text-muted">@c.City</div></td>
                        <td>@c.BuyerFullName</td>
                        <td>@c.SellerFullName</td>
                        <td><span class="badge @CaseWorkflow.BadgeClass(c.Status)">@CaseWorkflow.Display(c.Status)</span></td>
                        <td>
                            @if (pendingReview.TryGetValue(c.Id, out var n))
                            {
                                <span class="badge bg-info text-dark">@n</span>
                            }
                        </td>
                        <td class="small">@((c.UpdatedAt ?? c.CreatedAt).ToLocalTime().ToString("g"))</td>
                        <td><a class="btn btn-sm btn-primary" asp-action="Case" asp-route-id="@c.Id">Open</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
