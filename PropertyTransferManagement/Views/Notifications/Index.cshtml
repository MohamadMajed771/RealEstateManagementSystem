@model List<CaseNotification>
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Notifications</h2>
    @if (Model.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllRead" method="post">
            <button class="btn btn-sm btn-outline-secondary">Mark all as read</button>
        </form>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">You have no notifications.</div>
}
else
{
    <div class="list-group">
        @foreach (var n in Model)
        {
            <a asp-action="Open" asp-route-id="@n.Id"
               class="list-group-item list-group-item-action @(n.IsRead ? "" : "list-group-item-primary")">
                <div class="d-flex justify-content-between">
                    <strong>@n.Title</strong>
                    <small class="text-muted">@n.CreatedAt.ToLocalTime().ToString("g")</small>
                </div>
                <div class="small">@n.Message</div>
            </a>
        }
    </div>
}
