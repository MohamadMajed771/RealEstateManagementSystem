@model List<LoanAssistanceRequest>

@if (Model.Count > 0)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold">Loan-assistance requests</div>
        <div class="card-body">
            @foreach (var r in Model)
            {
                <div class="border rounded p-2 mb-2">
                    <div class="d-flex justify-content-between">
                        <strong>@r.RequestedAmount.ToString("N0") @r.Currency</strong>
                        <span class="badge bg-info text-dark">@CaseExtrasDisplay.Loan(r.Status)</span>
                    </div>
                    <div class="small text-muted">
                        @r.RequestedByUser.FirstName @r.RequestedByUser.LastName · @r.CreatedAt.ToLocalTime().ToString("g")
                        @if (r.PreferredBank != null) { <span>· prefers @r.PreferredBank</span> }
                        @if (r.LenderName != null) { <span>· lender: @r.LenderName</span> }
                    </div>
                    @if (r.AdditionalInformation != null) { <div class="small mt-1" style="white-space:pre-line">@r.AdditionalInformation</div> }
                    @if (r.LenderDecision != null) { <div class="small fw-semibold">@CaseExtrasDisplay.Lender(r.LenderDecision) (@r.LenderDecisionAt?.ToLocalTime().ToString("d"))</div> }

                    @if (CaseExtrasDisplay.LoanIsOpen(r.Status))
                    {
                        <form asp-controller="Loans" asp-action="Review" asp-route-id="@r.Id" method="post" class="row g-1 mt-2">
                            <div class="col-md-4">
                                <select name="status" class="form-select form-select-sm">
                                    @foreach (var s in new[] { LoanAssistanceStatus.UnderReview, LoanAssistanceStatus.InformationRequested, LoanAssistanceStatus.ReferredToBank, LoanAssistanceStatus.Closed, LoanAssistanceStatus.Rejected })
                                    {
                                        <option value="@s">@CaseExtrasDisplay.Loan(s)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4"><input name="lenderName" class="form-control form-control-sm" maxlength="200" placeholder="Lender (when submitting)" value="@r.LenderName" /></div>
                            <div class="col-md-4">
                                <select name="lenderDecision" class="form-select form-select-sm">
                                    <option value="">Lender decision…</option>
                                    <option value="@LenderDecision.ApprovedByLender">Approved by the lender</option>
                                    <option value="@LenderDecision.DeclinedByLender">Declined by the lender</option>
                                </select>
                            </div>
                            <div class="col-md-9"><input name="notes" class="form-control form-control-sm" maxlength="2000" placeholder="Note to the buyer (missing documents, next steps…)" /></div>
                            <div class="col-md-3"><button class="btn btn-sm btn-outline-primary w-100">Update</button></div>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
}
