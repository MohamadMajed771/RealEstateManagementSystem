@model (List<CaseAppointment> Items, bool IsOfficer, Guid CaseId)
@{
    var now = DateTime.UtcNow;
}

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Appointments &amp; administrative steps</div>
    <div class="card-body">
        @if (Model.Items.Count == 0)
        {
            <p class="text-muted small mb-0">No appointments yet.</p>
        }
        @foreach (var a in Model.Items)
        {
            var upcoming = a.EndAt > now && a.Status is CaseAppointmentStatus.Scheduled or CaseAppointmentStatus.Rescheduled;
            <div class="border rounded p-2 mb-2 @(upcoming ? "border-primary" : "bg-light")">
                <div class="d-flex justify-content-between flex-wrap gap-1">
                    <div>
                        <strong>@a.Title</strong>
                        <span class="badge bg-secondary ms-1">@a.Status</span>
                        <div class="small text-muted">
                            @CaseExtrasDisplay.Appointment(a.AppointmentType) · for @CaseExtrasDisplay.Audience(a.Audience)
                        </div>
                    </div>
                    <div class="small text-end">
                        <i class="bi bi-calendar-event"></i>
                        @a.StartAt.ToLocalTime().ToString("ddd d MMM yyyy, HH:mm") – @a.EndAt.ToLocalTime().ToString("HH:mm")
                    </div>
                </div>
                @if (a.Location != null) { <div class="small">📍 @a.Location</div> }
                @if (a.MeetingUrl != null) { <div class="small">💻 <a href="@a.MeetingUrl" target="_blank" rel="noopener noreferrer">Online meeting link</a></div> }
                @if (a.Description != null) { <div class="small mt-1" style="white-space:pre-line">@a.Description</div> }

                @if (Model.IsOfficer && upcoming)
                {
                    <form asp-controller="Appointments" asp-action="Update" asp-route-id="@a.Id" method="post" class="row g-1 mt-2 align-items-end">
                        <div class="col-sm-3">
                            <select name="status" class="form-select form-select-sm">
                                <option value="@CaseAppointmentStatus.Completed">Completed</option>
                                <option value="@CaseAppointmentStatus.Rescheduled">Reschedule</option>
                                <option value="@CaseAppointmentStatus.Cancelled">Cancelled</option>
                                <option value="@CaseAppointmentStatus.NoShow">No show</option>
                            </select>
                        </div>
                        <div class="col-sm-3"><input type="datetime-local" name="newStartAt" class="form-control form-control-sm" title="New date (when rescheduling)" /></div>
                        <div class="col-sm-4"><input name="note" class="form-control form-control-sm" maxlength="500" placeholder="Note to the parties" /></div>
                        <div class="col-sm-2"><button class="btn btn-sm btn-outline-primary w-100">Save</button></div>
                    </form>
                }
            </div>
        }

        @if (Model.IsOfficer)
        {
            <details class="mt-3">
                <summary class="fw-semibold">Schedule an appointment</summary>
                <form asp-controller="Appointments" asp-action="Create" method="post" class="row g-2 mt-1">
                    <input type="hidden" name="caseId" value="@Model.CaseId" />
                    <div class="col-md-6"><input name="title" class="form-control form-control-sm" placeholder="Purpose, e.g. Original deed verification" required maxlength="200" /></div>
                    <div class="col-md-3">
                        <select name="type" class="form-select form-select-sm">
                            @foreach (var t in Enum.GetValues<CaseAppointmentType>()) { <option value="@t">@CaseExtrasDisplay.Appointment(t)</option> }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="audience" class="form-select form-select-sm">
                            @foreach (var x in Enum.GetValues<CaseAppointmentAudience>()) { <option value="@x" selected="@(x == CaseAppointmentAudience.BuyerAndSeller)">@CaseExtrasDisplay.Audience(x)</option> }
                        </select>
                    </div>
                    <div class="col-md-4"><input type="datetime-local" name="startAt" class="form-control form-control-sm" required /></div>
                    <div class="col-md-2">
                        <select name="durationMinutes" class="form-select form-select-sm">
                            @foreach (var m in new[] { 15, 30, 45, 60, 90, 120 }) { <option value="@m" selected="@(m == 30)">@m min</option> }
                        </select>
                    </div>
                    <div class="col-md-6"><input name="location" class="form-control form-control-sm" maxlength="300" placeholder="Place (office, address…)" /></div>
                    <div class="col-md-6"><input name="meetingUrl" type="url" class="form-control form-control-sm" maxlength="500" placeholder="Online meeting link (optional)" /></div>
                    <div class="col-md-6"><input name="description" class="form-control form-control-sm" maxlength="1000" placeholder="Instructions (what to bring…)" /></div>
                    <div class="col-12"><button class="btn btn-sm btn-primary">Schedule and notify</button></div>
                </form>
            </details>
        }
    </div>
</div>
