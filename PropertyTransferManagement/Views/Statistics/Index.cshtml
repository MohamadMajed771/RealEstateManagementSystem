@model PropertyTransferManagement.Controllers.StatisticsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Statistics";
    string L(List<PropertyTransferManagement.Controllers.ChartPoint> p) => JsonSerializer.Serialize(p.Select(x => x.Label));
    string V(List<PropertyTransferManagement.Controllers.ChartPoint> p) => JsonSerializer.Serialize(p.Select(x => x.Value));

    var transfer = new (string, string)[]
    {
        ("Total requests", Model.TotalCases.ToString()), ("New this month", Model.NewThisMonth.ToString()),
        ("Pending", Model.Pending.ToString()), ("Waiting for documents", Model.WaitingDocuments.ToString()),
        ("Under review", Model.UnderReview.ToString()), ("Completed", Model.Completed.ToString()),
        ("Cancelled / rejected", Model.CancelledOrRejected.ToString()),
        ("Avg. processing", Model.AverageProcessingDays is double d ? $"{d} days" : "—")
    };
    var money = new (string, string)[]
    {
        ("Service revenue", Model.Revenue.ToString("N2") + " USD"), ("Paid services", Model.SucceededPayments.ToString()),
        ("Pending payments", Model.PendingPayments.ToString())
    };
    var loans = new (string, string)[]
    {
        ("Loan requests", Model.LoanTotal.ToString()), ("Awaiting documents", Model.LoanAwaitingDocuments.ToString()),
        ("Under review", Model.LoanUnderReview.ToString()), ("Submitted to lender", Model.LoanSubmittedToLender.ToString()),
        ("Lender decisions recorded", Model.LoanDecisionsRecorded.ToString())
    };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">Statistics</h2>
    <div class="d-flex flex-wrap gap-2 small">
        @foreach (var (action, label) in new[] { ("ExportCases", "Cases"), ("ExportOfficers", "Officers"), ("ExportPayments", "Payments"), ("ExportLoans", "Loans") })
        {
            <span class="border rounded px-2 py-1 bg-white">
                @label:
                <a asp-action="@action" asp-route-format="xlsx">Excel</a> ·
                <a asp-action="@action" asp-route-format="pdf">PDF</a>
            </span>
        }
    </div>
</div>

@foreach (var (title, tiles) in new[] { ("Transfers", transfer), ("Payments", money), ("Loan assistance", loans) })
{
    <h6 class="text-muted text-uppercase small mt-3">@title</h6>
    <div class="row g-3 mb-2">
        @foreach (var (label, value) in tiles)
        {
            <div class="col-6 col-md-3 col-xl">
                <div class="card h-100"><div class="card-body py-2">
                    <div class="small text-muted">@label</div>
                    <div class="fs-4 fw-semibold">@value</div>
                </div></div>
            </div>
        }
    </div>
}

<div class="row g-3 mt-2">
    <div class="col-lg-6"><div class="card card-body"><h6>New cases (last 12 months)</h6><canvas id="casesMonth" height="140"></canvas></div></div>
    <div class="col-lg-6"><div class="card card-body"><h6>Cases by status</h6><canvas id="casesStatus" height="140"></canvas></div></div>
    <div class="col-lg-6"><div class="card card-body"><h6>Service revenue, USD (last 12 months)</h6><canvas id="revenueMonth" height="140"></canvas></div></div>
    <div class="col-lg-6"><div class="card card-body"><h6>Revenue by service</h6><canvas id="revenueService" height="140"></canvas></div></div>
    <div class="col-lg-6"><div class="card card-body"><h6>Loan requests by status</h6><canvas id="loanStatus" height="140"></canvas></div></div>
    <div class="col-lg-6"><div class="card card-body"><h6>Active cases per officer</h6><canvas id="officerLoad" height="140"></canvas></div></div>
</div>

<h5 class="mt-4">Officers</h5>
<div class="table-responsive">
    <table class="table bg-white align-middle">
        <thead class="table-light"><tr><th>Officer</th><th class="text-center">Active cases</th><th class="text-center">Documents to review</th><th class="text-center">Completed</th><th class="text-center">Avg. days to complete</th></tr></thead>
        <tbody>
        @foreach (var o in Model.Officers)
        {
            <tr>
                <td>@o.Name<div class="small text-muted">@o.Email</div></td>
                <td class="text-center">@o.ActiveCases</td>
                <td class="text-center">@o.PendingReviews</td>
                <td class="text-center">@o.CompletedCases</td>
                <td class="text-center">@(o.AverageDays?.ToString() ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const palette = ['#2563eb', '#16a34a', '#f59e0b', '#dc2626', '#7c3aed', '#0891b2', '#db2777', '#64748b', '#84cc16', '#f97316', '#0f766e'];
            const plain = { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } };
            const chart = (id, type, labels, data, color, extra) => new Chart(document.getElementById(id), {
                type,
                data: { labels, datasets: [{ data, backgroundColor: color || palette, borderColor: color, fill: type === 'line', tension: 0.3 }] },
                options: Object.assign({}, type === 'doughnut' ? { plugins: { legend: { position: 'right' } } } : plain, extra || {})
            });
            chart('casesMonth', 'bar', @Html.Raw(L(Model.CasesPerMonth)), @Html.Raw(V(Model.CasesPerMonth)), '#2563eb');
            chart('casesStatus', 'doughnut', @Html.Raw(L(Model.CasesByStatus)), @Html.Raw(V(Model.CasesByStatus)));
            chart('revenueMonth', 'line', @Html.Raw(L(Model.RevenuePerMonth)), @Html.Raw(V(Model.RevenuePerMonth)), '#7c3aed');
            chart('revenueService', 'doughnut', @Html.Raw(L(Model.RevenueByService)), @Html.Raw(V(Model.RevenueByService)));
            chart('loanStatus', 'bar', @Html.Raw(L(Model.LoansByStatus)), @Html.Raw(V(Model.LoansByStatus)), '#0891b2', { indexAxis: 'y' });
            chart('officerLoad', 'bar', @Html.Raw(JsonSerializer.Serialize(Model.Officers.Select(o => o.Name))), @Html.Raw(JsonSerializer.Serialize(Model.Officers.Select(o => o.ActiveCases))), '#16a34a');
        })();
    </script>
}
