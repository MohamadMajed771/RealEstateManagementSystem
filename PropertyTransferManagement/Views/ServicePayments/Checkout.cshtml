@model PropertyTransferManagement.Controllers.ServiceCheckoutViewModel
@{ ViewData["Title"] = "Pay for a service"; }

<div class="container py-4" style="max-width:640px">
    <h2>Pay for a service</h2>

    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between">
            <div>
                <div class="fw-semibold">@Model.ServiceName</div>
                <div class="text-muted small">Case @Model.CaseNumber</div>
            </div>
            <div class="fs-4 fw-bold">@Model.Amount.ToString("N2") @Model.Currency</div>
        </div>
    </div>

    <div class="alert alert-warning small">
        This is an optional <strong>assistance service fee</strong> charged by the transfer service.
        It is <strong>not</strong> a government tax, registration fee or any other official charge.
    </div>
    <div class="alert alert-secondary small">
        <strong>Test payment gateway</strong> — no real money is charged and card details are not stored.
        Use <code>4242 4242 4242 4242</code> (success) or <code>4000 0000 0000 0002</code> (declined),
        any future date and any 3-digit CVC.
    </div>

    @if (!string.IsNullOrEmpty(Model.LastError)) { <div class="alert alert-danger">@Model.LastError</div> }

    <form asp-action="Checkout" asp-route-id="@Model.PaymentId" method="post" class="card card-body shadow-sm" autocomplete="off" id="payForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="CardholderName" class="form-label"></label>
            <input asp-for="CardholderName" class="form-control" />
            <span asp-validation-for="CardholderName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CardNumber" class="form-label"></label>
            <input asp-for="CardNumber" class="form-control" inputmode="numeric" placeholder="4242 4242 4242 4242" />
            <span asp-validation-for="CardNumber" class="text-danger"></span>
        </div>
        <div class="row g-2 mb-3">
            <div class="col-4"><label asp-for="ExpMonth" class="form-label"></label><input asp-for="ExpMonth" type="number" min="1" max="12" class="form-control" /></div>
            <div class="col-4"><label asp-for="ExpYear" class="form-label"></label><input asp-for="ExpYear" type="number" min="2000" max="2100" class="form-control" /></div>
            <div class="col-4"><label asp-for="Cvc" class="form-label"></label><input asp-for="Cvc" class="form-control" inputmode="numeric" maxlength="4" /></div>
        </div>
        <button class="btn btn-success btn-lg" id="payBtn">Pay @Model.Amount.ToString("N2") @Model.Currency</button>
        <a asp-controller="Cases" asp-action="Details" asp-route-id="@Model.CaseId" class="btn btn-link">Back to the case</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('payForm').addEventListener('submit', function () {
            const b = document.getElementById('payBtn');
            setTimeout(() => { b.disabled = true; b.textContent = 'Processing…'; }, 0);
        });
    </script>
}
